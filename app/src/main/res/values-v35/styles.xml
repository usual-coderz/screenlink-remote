<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      API 35 par edge-to-edge default hai, isliye statusBarColor/navigationBarColor
      apne aap ignore ho jaate. windowOptOutEdgeToEdgeEnforcement=true se purana
      behaviour wapas milta hai.

      NOTE: API 36 (Android 16) par opt-out hata diya gaya hai — wahan ye attribute
      ignore hoga aur bars transparent rahenge. Us case me WindowCompat se handle karna padta hai.
    -->
    <style name="AppTheme" parent="AppTheme.Base">
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

</resources>