    // ------------------------------------------------------------ helpers
    private fun prefs() = getSharedPreferences(PREFS, Context.MODE_PRIVATE)

    private fun registrationId(): String {
        val p = prefs()
        p.getString(KEY_RID, null)?.let { if (it.isNotBlank()) return it }
        val id = UUID.randomUUID().toString()
