function setLink(t){ const el=$("#linkLabel"); if(el)el.textContent=t; }
function updateLink(){
const el=$("#linkLabel");
if(el)el.textContent=DEMO?"Demo":(state.wsOk?"Socket live":(state.linkOk?"Polling":"Link down"));
badge($("#wsBadge"),state.wsOk?"Live":"Polling",state.wsOk?"ok":"warn");
}

function connectWs(){
if(!state.auth||DEMO)return;
if(state.ws&&(state.ws.readyState===0||state.ws.readyState===1))return;
try{
const proto=location.protocol==="https:"?"wss:":"ws:";
const qs=token()?"?token="+encodeURIComponent(token()):"";
const ws=new WebSocket(proto+"//"+location.host+"/ws/admin"+qs);
state.ws=ws;
ws.onopen=()=>{ state.wsOk=true; state.wsFails=0; updateLink(); };
ws.onmessage=(ev)=>{ try{ onEvent(JSON.parse(ev.data)); }catch(e){} };
ws.onclose=()=>{ state.wsOk=false; updateLink(); reconnect(); };
ws.onerror=()=>{ state.wsOk=false; try{ ws.close(); }catch(e){} };
}catch(e){ reconnect(); }
}
function reconnect(){
clearTimeout(state.wsTimer);
state.wsFails=Math.min((state.wsFails||0)+1,6);
state.wsTimer=setTimeout(()=>{ if(state.auth)connectWs(); },Math.min(1500*state.wsFails,15000));
}

function onEvent(msg){
if(!msg||typeof msg!=="object")return;
const type=String(msg.type||msg.event||"").toLowerCase();
const data=(msg.data&&typeof msg.data==="object")?msg.data:msg;
if(data.body||type.indexOf("sms")>=0||type.indexOf("message")>=0)upsertMessage(data);
if(type.indexOf("telemetry")>=0||type.indexOf("device")>=0||type.indexOf("status")>=0){
const id=data.device_id||data.id||data._id;
if(id){
const idx=state.devices.findIndex((x)=>String(devId(x))===String(id));
if(idx>=0){
state.devices[idx]=Object.assign({},state.devices[idx],data);
safe(renderCards); safe(renderLive); safe(renderOverview);
if(state.active&&String(devId(state.active))===String(id)){
state.active=state.devices[idx]; safe(renderDetail,state.active); }
}else loadDevices().catch(()=>{});
}
}
if(type.indexOf("ack")>=0||type.indexOf("sent")>=0){
const did=data.device_id; const dbody=data.body;
const j=state.outbox.find((x)=>x.status!=="sent"&&x.status!=="failed"&&
(!did||String(x.deviceId)===String(did))&&(!dbody||String(x.body)===String(dbody)));
if(j){ j.status=data.status==="failed"?"failed":"sent"; renderOutbox(); }
}
if(type.indexOf("growth")>=0||type.indexOf("outbox_stats")>=0){
loadStats().catch(()=>{});
if(type.indexOf("growth")>=0)loadGrowthEvents().catch(()=>{});
}
}

function schedulePoll(){
clearTimeout(state.pollTimer);
const fast=state.devices.some(online);
state.pollTimer=setTimeout(async()=>{
if(state.auth&&!document.hidden){
await Promise.allSettled([loadDevices(),loadMessages(),loadStats()]);
}
schedulePoll();
},fast?8000:20000);
}
function scheduleProbe(){
setTimeout(async()=>{
if(DEMO){ try{ const r=await fetch("/health",{credentials:"same-origin"});
if(r.ok){ leaveDemo(); await refreshAll(); } }catch(e){} }
scheduleProbe();
},25000);
}
