.spec-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:10px}
.spec{padding:10px 11px;border:1px solid var(--border);border-radius:10px;background:linear-gradient(160deg,#0a1226,#070d1c)}
.spec-k{font-size:9.5px;letter-spacing:1.3px;text-transform:uppercase;color:#35507e;font-weight:700}
.spec-v{margin-top:6px;font-size:13px;font-weight:700;color:#e3f1ff;overflow-wrap:anywhere;font-family:var(--mono)}
.more-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}
.more-row{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid #0f1e3d;font-size:12.5px}
.more-row span:first-child{color:var(--muted)}
.more-row span:last-child{font-family:var(--mono);text-align:right;overflow-wrap:anywhere}
.out-item{display:flex;align-items:center;gap:9px;padding:9px 0;border-bottom:1px solid #0f1e3d;font-size:12px}
.out-item:last-child{border-bottom:0}
.out-body{flex:1;min-width:0;font-family:var(--mono);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#bcd4f5}
.out-time{color:#35507e;font-size:10.5px}
.searchbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;padding:12px 16px;
border-bottom:1px solid var(--border);background:#0a1226}
.searchbar input{flex:1 1 200px;min-width:150px}
.searchbar select{width:auto}
.searchbar .lbl{gap:7px;cursor:pointer;margin:0;text-transform:none;letter-spacing:.4px}
.searchbar input[type=checkbox]{width:auto}
.msg-list{flex:1;min-height:0;overflow-y:auto;max-height:none}
.msg{padding:13px 16px;border-bottom:1px solid #0f1e3d}
.msg:last-child{border-bottom:0}
.msg:hover{background:#22d3ee08}
.msg-head{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:7px;font-size:11.5px}
.msg-addr{font-family:var(--mono);color:#bcd4f5}
.msg-time{margin-left:auto;color:#35507e;font-size:11px}
.msg-body{font-family:var(--mono);font-size:12.5px;color:#d5e7ff;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.65}
.msg-foot{margin-top:8px;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.pre-out{margin:12px 0 0;padding:12px;border:1px solid var(--border);border-radius:10px;
background:#04091a;font-family:var(--mono);font-size:12px;color:var(--muted);
white-space:pre-wrap;overflow-wrap:anywhere;min-height:18px}
.divider{display:flex;align-items:center;gap:12px;margin:26px 0 16px;color:#35507e;
font-size:10.5px;font-weight:800;letter-spacing:1.8px;text-transform:uppercase}
.divider::before,.divider::after{content:"";flex:1;height:1px;background:var(--border)}

.act-wrap{position:relative}
.act-menu{position:absolute;top:calc(100% + 8px);right:0;z-index:60;min-width:196px;padding:6px;
border-radius:12px;background:#0a1226;border:1px solid var(--border-hi);
box-shadow:0 18px 44px #000c,0 0 30px #22d3ee14}
.act-menu button{display:flex;align-items:center;gap:9px;width:100%;padding:9px 11px;border:0;
border-radius:8px;background:transparent;color:#bcd4f5;font-size:12.5px;font-weight:600;text-align:left}
.act-menu button:hover{background:#22d3ee14;color:#fff}

.switch{position:relative;width:46px;height:26px;flex:0 0 auto;border-radius:999px;
border:1px solid var(--border-hi);background:#0d1628;transition:.2s}
.switch::after{content:"";position:absolute;top:2px;left:2px;width:20px;height:20px;
border-radius:50%;background:#4b6489;transition:.2s}
.switch.on{background:#34d39926;border-color:#34d39980}
.switch.on::after{left:22px;background:var(--green);box-shadow:0 0 14px #34d399a6}

.as-panel{border-color:#22d3ee33}
.as-head{display:flex;align-items:center;gap:12px;padding:14px 18px;background:#0d1730a6;border-bottom:1px solid var(--border)}
.as-ico{display:grid;place-items:center;width:38px;height:38px;flex:0 0 auto;border-radius:11px;
font-size:17px;background:#22d3ee14;border:1px solid #22d3ee33}
.as-title{display:flex;align-items:center;gap:9px;font-size:13.5px;font-weight:700}
.as-sub{margin-top:2px;font-size:11.5px;color:var(--muted)}
.as-body{padding:16px 18px}
.step{border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:12px;background:#0a1226}
.step-tag{display:inline-block;font-size:10px;font-weight:800;letter-spacing:1.4px;color:var(--neon);
background:#22d3ee14;border:1px solid #22d3ee33;border-radius:6px;padding:3px 8px}
.step-desc{margin:10px 0 12px;font-size:13px;color:#bcd4f5}
.copy-row{display:flex;align-items:center;justify-content:space-between;gap:10px;
padding:9px 12px;border:1px dashed var(--border-hi);border-radius:10px;background:#04091a}
.copy-row .mono{font-size:13px;color:var(--neon)}
.inline{display:flex;gap:9px;align-items:center}
.inline input{flex:1}
.hint{margin:9px 0 12px;font-size:11.5px;color:#35507e}
.ok-msg{display:flex;align-items:center;gap:8px;margin:9px 0;padding:9px 11px;border-radius:9px;
font-size:12.5px;color:var(--green);background:#34d39914;border:1px solid #34d39933}
.ok-msg.bad{color:#ffd0da;background:#ff5c7a14;border-color:#ff5c7a33}
.status-panel{margin:12px 0;padding:11px 13px;border-radius:10px;font-size:12.5px;color:var(--green);
background:#34d39912;border:1px solid #34d39933;border-left:3px solid var(--green)}
.status-panel.off{color:var(--muted);background:#ffffff05;border-color:var(--border);border-left-color:var(--dim)}
.status-panel .mono{color:#a7f3d0}
.toggle-row{display:flex;align-items:center;justify-content:space-between;gap:12px;
padding:11px 0;border-bottom:1px solid #0f1e3d}
.toggle-row:last-of-type{border-bottom:0}
.toggle-row .t-name{font-size:13px;font-weight:600}
.toggle-row .t-desc{margin-top:3px;font-size:11.5px;color:var(--muted)}
.u-actions{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.u-actions input[type=date]{width:150px;padding:7px 9px;font-size:12px;font-family:var(--mono)}
.keygen{display:grid;grid-template-columns:1.2fr 1fr 150px auto;gap:12px;align-items:end;padding:16px}
.keyout{margin-top:14px;padding:14px;border-radius:12px;background:#0a1226;
border:1px dashed #fbbf2455;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.keyout .k{font-family:var(--mono);font-size:20px;font-weight:800;letter-spacing:3px;color:#fde68a;
text-shadow:0 0 20px #fbbf2440;overflow-wrap:anywhere}

.bar{height:8px;border-radius:999px;background:#0f1e3d;overflow:hidden;margin-top:10px}
.bar>span{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,#22d3ee,#38bdf8)}
.bar.red>span{background:linear-gradient(90deg,#ff5c7a,#fbbf24)}

@media (max-width:1100px){
