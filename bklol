function reconcile(){
state.outbox.forEach((j)=>{
if(j.status==="sent"||j.status==="failed")return;
const hit=state.messages.some((m)=>String(m.device_id)===String(j.deviceId)&&
m.direction==="out"&&String(m.body||"").trim()===String(j.body||"").trim()&&
new Date(m.created_at||0).getTime()>=j.at-60000);
if(hit)j.status="sent";
});
renderOutbox();
}

