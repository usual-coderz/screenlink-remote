.muted{color:var(--muted)}.small{font-size:12px}.mono{font-family:var(--mono)}
.upper{text-transform:uppercase;letter-spacing:1.5px}.w100{width:100%}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-track{background:#060b16}
::-webkit-scrollbar-thumb{background:#1c3a6b;border-radius:6px}
::-webkit-scrollbar-thumb:hover{background:var(--neon)}
::selection{background:var(--neon);color:#001521}
mark{background:#22d3ee4d;color:#eaf6ff;border-radius:3px;padding:0 2px}

.cat{width:46px;height:46px;flex:0 0 auto;filter:drop-shadow(0 0 12px #8b5cf655)}
.cat .eye{transform-origin:center;animation:blink 4.6s infinite}
