async function api(path,options,retry){
if(DEMO)return mockApi(path,options);
const o=options||{};
const headers=Object.assign(
{"Accept":"application/json"},
token()?{"Authorization":"Bearer "+token()}:{},
o.body?{"Content-Type":"application/json"}:{},
o.headers||{}
);
let res;
try{ res=await fetch(path,{credentials:"same-origin",method:o.method||"GET",headers:headers,body:o.body}); }
catch(err){ enterDemo(); return mockApi(path,o); }
const ct=res.headers.get("content-type")||"";
if(ct.indexOf("application/json")<0&&res.status>=400){ enterDemo(); return mockApi(path,o); }
let data=null;
if(ct.indexOf("application/json")>=0)data=await res.json().catch(()=>({}));
else{ const txt=await res.text(); data=txt?{detail:txt}:{}; }

if(res.status===401||res.status===403){
const e=new Error(data.detail||"Authentication required."); e.auth=true;
if(retry!==false){
const ok=await relogin();
if(ok)return api(path,options,false);
if(state.auth)showLogin("Session expire ho gaya — dobara sign in karo");
}
throw e;
}
if(!res.ok){
let m=data.detail||data.message||("Failed ("+res.status+")");
if(Array.isArray(m))m=m.map((x)=>x.msg||String(x)).join(", ");
const e2=new Error(m); e2.status=res.status; throw e2;
}
return data;
}

async function relogin(){
const s=readSession(); if(!s)return false;
if(reloginPromise)return reloginPromise;
reloginPromise=(async()=>{
try{
let r;
if(s.pass) r=await api("/panel/login",{method:"POST",body:JSON.stringify({username:s.id,password:decPass(s.pass)})},false);
else r=await api("/panel/access",{method:"POST",body:JSON.stringify({key:s.id})},false);
if(r&&r.token)setToken(r.token);
if(r&&r.role)state.role=r.role;
return true;
}catch(e){ return false; } finally{ reloginPromise=null; }
})();
return reloginPromise;
}

