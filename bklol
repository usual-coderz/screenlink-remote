@keyframes blink{0%,90%,100%{transform:scaleY(1)}94%,97%{transform:scaleY(.08)}}
@keyframes twitch{0%,86%,100%{transform:rotate(0)}91%{transform:rotate(-7deg)}96%{transform:rotate(5deg)}}

.panel{position:relative;background:linear-gradient(160deg,#0a1226,#060b18);
border:1px solid var(--border);border-radius:var(--radius);
box-shadow:0 0 0 1px #38bdf80f,0 18px 50px #000000a6,inset 0 1px 0 #ffffff08}
