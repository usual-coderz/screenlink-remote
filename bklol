                              "$gte": now - timedelta(hours=IDLE_AFTER_HOURS)}
    elif state == "stale":
        query["last_seen"] = {"$lt": now - timedelta(hours=IDLE_AFTER_HOURS),
                              "$gte": now - timedelta(days=STALE_AFTER_DAYS)}
    elif state == "uninstalled":
