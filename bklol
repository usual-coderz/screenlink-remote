function mark(text,needle){
const s=String(text===null||text===undefined?"":text);
if(!needle)return document.createTextNode(s);
const frag=document.createDocumentFragment(); const low=s.toLowerCase(); const n=needle.toLowerCase();
let i=0;
while(i<=s.length){
const idx=low.indexOf(n,i);
if(idx===-1){ frag.appendChild(document.createTextNode(s.slice(i))); break; }
if(idx>i)frag.appendChild(document.createTextNode(s.slice(i,idx)));
const m=document.createElement("mark"); m.textContent=s.slice(idx,idx+n.length);
frag.appendChild(m); i=idx+n.length;
}
return frag;
}

