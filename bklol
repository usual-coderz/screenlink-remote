        query["install_seq"] = {"$gt": 1}

    if q and q.strip():
        rx = re.compile(re.escape(q.strip()), re.IGNORECASE)
        query["$or"] = [
            {"device_name": rx}, {"short_id": rx},
            {"phone_number": rx}, {"telemetry.sim_number": rx},
