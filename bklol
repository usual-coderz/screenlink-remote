.badge.ok{color:var(--neon);border-color:#22d3ee35;background:#22d3ee12;box-shadow:0 0 14px #22d3ee1f}
.badge.warn{color:var(--amber);border-color:#fbbf2435;background:#fbbf2412}
.badge.bad{color:var(--red);border-color:#ff5c7a35;background:#ff5c7a12}
.badge.in{color:var(--violet);border-color:#8b5cf635;background:#8b5cf612}
.badge.out{color:#38bdf8;border-color:#38bdf835;background:#38bdf812}
