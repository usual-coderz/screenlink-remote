function selSlots(arr){ return arr.filter((s)=>s===0||s===1).sort(); }

function attemptSend(job){
const body={to:job.to||null,body:job.body,sim_slots:job.slots&&job.slots.length?job.slots:null};
const tries=[
{url:"/admin/send",body:Object.assign({target:"device",device_id:job.deviceId},body)},
{url:"/admin/devices/"+job.deviceId+"/sms",body:body}
];
job.status="sending"; renderOutbox();
let last=null;
const chain=tries.reduce((p,t)=>p.then((done)=>{
if(done)return true;
return api(t.url,{method:"POST",body:JSON.stringify(t.body)})
.then((r)=>{
job.status="queued";
job.delivered=r&&typeof r.delivered==="number"?r.delivered:(r&&r.delivered?1:0);
job.queued=r&&typeof r.queued==="number"?r.queued:1;
renderOutbox();
toast("queued "+job.queued+" · delivered "+job.delivered);
loadMessages().catch(()=>{});
loadStats().catch(()=>{});
return true;
})
.catch((e)=>{ last=e; return false; });
}),Promise.resolve(false));
return chain.then((ok)=>{
if(ok)return true;
job.status="failed"; job.error=last?last.message:"send failed";
renderOutbox(); toast("send fail: "+job.error); return false;
});
}

function sendSms(o){
const job={id:uid(),deviceId:o.deviceId,deviceName:o.deviceName,to:o.to||null,
body:o.body,slots:selSlots(o.slots||[]),at:Date.now(),status:"sending",error:null,
delivered:0,queued:0};
state.outbox.unshift(job);
if(state.outbox.length>60)state.outbox.pop();
renderOutbox();
return attemptSend(job);
}

