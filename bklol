label{display:block;color:#a8c2ea;font-size:11px;letter-spacing:1.3px;text-transform:uppercase;margin:15px 0 7px}
input,textarea,select{width:100%;padding:12px 13px;color:var(--text);background:#04091a;
border:1px solid var(--border);border-radius:10px;outline:none;transition:.15s}
textarea{resize:vertical;min-height:84px;font-size:13px}
input::placeholder,textarea::placeholder{color:#35507e}
input:focus,textarea:focus,select:focus{border-color:var(--neon);box-shadow:0 0 0 3px #22d3ee1f,0 0 22px #22d3ee26}
.chk{display:flex;align-items:center;gap:9px;margin:16px 0 0;font-size:12px;text-transform:none;letter-spacing:0;color:var(--muted);font-weight:500}
