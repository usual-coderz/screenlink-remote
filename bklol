.login{min-height:100vh;display:grid;place-items:center;padding:24px}
.login-card{width:100%;max-width:430px;padding:32px;border-radius:22px;
background:linear-gradient(160deg,#0a1226,#050a18);border:1px solid var(--border);
box-shadow:0 0 0 1px #38bdf81a,0 30px 90px #000000b3,0 0 80px #1e3a8a2e}
.brand{display:flex;align-items:center;gap:13px}
