.side-foot{margin:26px 8px 0;padding-top:16px;border-top:1px solid var(--border);color:#35507e;font-size:11px;line-height:1.9}
main{width:100%;max-width:1600px;padding:26px;margin:0 auto;min-width:0}
.head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:22px;flex-wrap:wrap}
.head h2{margin:0 0 6px;font-size:clamp(21px,2.6vw,27px);font-weight:800;letter-spacing:-.4px;
background:linear-gradient(100deg,#e8f4ff,#7dd3fc);-webkit-background-clip:text;background-clip:text;color:transparent}
