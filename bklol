border-radius:999px;padding:7px 12px;font-size:11px;color:var(--muted);letter-spacing:.8px}
.dot{width:7px;height:7px;border-radius:50%;background:var(--neon);box-shadow:0 0 10px var(--neon);animation:pulse 2s infinite}
@keyframes pulse{50%{opacity:.3}}
.tg{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;
color:#7fd8ff;background:#229ed917;border:1px solid #229ed940;transition:.15s}
.tg:hover{color:#fff;background:#229ed9;border-color:#229ed9;box-shadow:0 0 24px #229ed966}
.apk{display:inline-flex;align-items:center;gap:8px;height:38px;padding:0 14px;border-radius:999px;
color:#c8f7d4;background:#34d39915;border:1px solid #34d39945;font-size:12px;font-weight:800;
letter-spacing:1px;transition:.15s}
.apk:hover{color:#001b10;background:#34d399;border-color:#34d399;box-shadow:0 0 26px #34d39966;text-shadow:none}
.apk svg{flex:0 0 auto}

.layout{display:grid;grid-template-columns:216px minmax(0,1fr);min-height:calc(100vh - 63px)}
.side{padding:20px 12px;border-right:1px solid var(--border);background:linear-gradient(180deg,#060b18,#04060d)}
.side-label{padding:0 10px;margin:0 0 10px;color:#35507e;font-size:10px;font-weight:800;letter-spacing:1.8px;text-transform:uppercase}
.nav{display:flex;align-items:center;gap:10px;width:100%;padding:11px;margin-bottom:4px;
text-align:left;color:var(--muted);background:transparent;border:1px solid transparent;
border-radius:10px;font-size:13px;font-weight:500;transition:.14s}
