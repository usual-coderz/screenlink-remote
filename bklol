.keyinput{font-family:var(--mono);font-size:16px;letter-spacing:2.5px;text-transform:uppercase;text-align:center}

.btn{border:1px solid transparent;border-radius:10px;padding:11px 16px;font-weight:700;font-size:13px;letter-spacing:.6px;transition:.15s}
.btn.primary{color:#001521;background:linear-gradient(100deg,#22d3ee,#38bdf8);box-shadow:0 0 24px #22d3ee4d}
