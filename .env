# ==========================================================
#  TPC PANEL — environment
#  Path: /opt/tpc-panel/.env     chmod 600, owner tpc
# ==========================================================

NODE_ENV=production
PORT=8000
APP_VERSION=2.0.0

# ---------------------- database --------------------------
# Atlas SRV URI (password me special char ho to URL-encode karo)
MONGO_URL=mongodb+srv://itzrayn01_db_user:7MufiiQtN2lJ02Sc@cluster0.bfxbeey.mongodb.net/?appName=Cluster0
DB_NAME=tpc_panel
DB_AUTODETECT=1

MONGO_SELECT_TIMEOUT_MS=15000
MONGO_CONNECT_TIMEOUT_MS=15000
MONGO_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_WATCHDOG_MS=15000
MONGO_RETRIES=60
MONGO_RETRY_DELAY_MS=2000
# MONGO_TLS=1
# MONGO_DIRECT=0        # SRV ke saath directConnection mat lagao

# ---------------------- session / auth --------------------
SESSION_SECRET=8f3c9a2e7b1d6f4a0c5e8b9d2a7f1c6e
COOKIE_NAME=tpc_session
COOKIE_DOMAIN=
COOKIE_SECURE=0
SESSION_MAX_AGE=2592000
TRUST_PROXY=1

# naya env.js isko padhta hai — primary source
ADMINS=ivan:Ahad@198612

# purane config.js ke liye rakha hua (compat)
ADMIN_USERNAME=ivan
ADMIN_PASSWORD=Ahad@198612
ADMIN_API_KEY=some-api-key
USER_TRIAL_DAYS=30

# ---------------------- relay / telegram ----------------
TELE_API_ID=22657083
TELE_API_HASH=d6186691704bd901bdab275ceaab88f3
TARGET_CHANNEL_ID=
DEFAULT_FWD_USER=

# ---------------------- builder core ---------------------
BUILDER_ENGINE=node
BUILDER_WORKER_MODE=inline
#   node backend/server.js            -> inline (web hi build karega)
#   node backend/server.js --workers 2 -> api    (web sirf serve)
#   node backend/server.js --worker    -> inline (dedicated worker)
# BUILDER_WORKER_MODE=

MAX_CONCURRENT_BUILDS=2
BUILD_POLL_MS=1500
BUILD_STALE_MS=3600000
BUILD_TIMEOUT_MS=2400000
BUILD_QUOTA_PER_DAY=0
DEFAULT_VARIANT=prod
DEFAULT_THEME=mono
REQUIRE_SIGNATURE=1
CLEAN_WORKDIR=0

# ---------------------- toolchain -------------------------
USE_DOCKER=0
AUTO_JDK=1
AUTO_SDK=1
AUTO_GRADLE=1

# khaali = wrapper -> PATH -> runtime download auto-detect
GRADLE_BIN=
# GRADLE_BIN=/opt/gradle/bin/gradle

JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# ^ path galat ho to AUTO_JDK=1 khud JDK 17 download kar lega

# ---------------------- paths -----------------------------
STORAGE_ROOT=/opt/tpc-panel/storage
BUILD_ROOT=/opt/tpc-panel/storage/builds
KEYSTORE_DIR=/opt/tpc-panel/storage/keystores
GRADLE_ROOT=/opt/tpc-panel/storage/gradle
GRADLE_USER_HOME=/opt/tpc-panel/storage/.gradle

# apk_template kahan hai, pehle verify karo:
#   ls -d /opt/tpc-panel/apk_template /opt/tpc-panel/backend/apk_template
TEMPLATE_DIR=/opt/tpc-panel/backend/apk_template

# ANDROID_SDK_ROOT khaali chhodo -> STORAGE_ROOT/android-sdk me ban jayega
# ANDROID_SDK_ROOT=/opt/tpc-panel/storage/android-sdk

# ---------------------- cluster ---------------------------
CLUSTER_PORT_SPREAD=1
WEB_CONCURRENCY=2

# ---------------------- optional: S3 artifacts ------------
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=apks
# S3_PUBLIC_BASE=