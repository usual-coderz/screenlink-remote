        throw new u.HttpError(400, `2FA failed: ${e2.message || e2}`);
      }
    } else {
      throw new u.HttpError(400, `sign-in failed: ${e.message || e}`);
    }
  }

  await afterRelayLogin(relayState.api_id, relayState.api_hash);
  res.json({ status: "ok", me: relayState.me });
}));

