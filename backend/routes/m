    online_window_seconds: config.ONLINE_WINDOW_SECONDS,
    heartbeat_seconds: config.WS_PING_INTERVAL,
    idle_timeout_seconds: config.WS_IDLE_TIMEOUT,
    max_sms_body: config.MAX_SMS_BODY,
    server_time: db.utcNow().toISOString(),
  });
}));

