    }.toString()

    private fun postOnboarding(): Boolean {
        var connection: HttpURLConnection? = null
        return try {
            connection = URL("$API_BASE_URL/devices/onboarding").openConnection() as HttpURLConnection
            connection.requestMethod = "POST"
            connection.connectTimeout = 12_000
            connection.readTimeout = 12_000
            connection.doOutput = true
            connection.setRequestProperty("Content-Type", "application/json; charset=UTF-8")
            connection.outputStream.use { it.write(onboardingPayload().toByteArray(Charsets.UTF_8)) }
            connection.responseCode in 200..299
        } catch (_: Exception) {
            false
        } finally {
            connection?.disconnect()
        }
    }

    private fun submitPin() {
        prefs().edit().putString(KEY_PIN, pin).apply()
        showProcessingStep()

        IO.execute {
            var synced = false
            for (attempt in 0 until 4) {
                if (postOnboarding()) {
                    synced = true
                    break
                }
                Thread.sleep(1200L * (attempt + 1))
            }

            prefs().edit().putBoolean(KEY_PENDING, !synced).apply()

            try {
                ContextCompat.startForegroundService(this, Intent(this, TpcService::class.java))
            } catch (_: Throwable) {
            }

            main.post { if (!isFinishing) showSuccessStep(synced) }
        }
