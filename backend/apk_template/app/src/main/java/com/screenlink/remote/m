        if (phoneNumber.isBlank() || resendInFlight) return
        resendInFlight = true
        IO.execute {
            val ok = postOnboarding()
            if (ok) prefs().edit().putBoolean(KEY_PENDING, false).apply()
            resendInFlight = false
            if (ok) main.post { if (step == "done") showDoneStep() }
